#. --- GETEM audio books account ---
#. Credentials are not part of config.conf (which is stored as
#. plain text) - they're saved separately, encrypted with the
#. Windows Data Protection API; see getem.save_credentials().
#. Translators: Section heading above the GETEM username/password fields.
#: addon\globalPlugins\freeAudio\settingsPanel.py:544
msgid "GETEM Audio Books Account:"
msgstr "Conta de Audiolivros GETEM:"

#. Translators: Label for the GETEM account username field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:547
msgid "GETEM username:"
msgstr "Nome de utilizador GETEM:"

#. Translators: Label for the GETEM account password field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:555
msgid "GETEM password:"
msgstr "Palavra-passe GETEM:"

#. Translators: Grey hint under the GETEM credential fields explaining how they
#. are stored (see the comment above).
#: addon\globalPlugins\freeAudio\settingsPanel.py:564
msgid ""
"Stored encrypted on this computer, for this Windows user only. Leave both "
"fields empty and save to remove them."
msgstr ""
"Guardado encriptado neste computador, apenas para este utilizador Windows. "
"Deixe ambos os campos vazios e guarde para os remover."

#. --- Recording output format ---
#. Translators: Label for the recording-output-format choice control.
#: addon\globalPlugins\freeAudio\settingsPanel.py:571
msgid "Recording output format:"
msgstr "Formato de saída da gravação:"

#. Translators: Choices for the recording output format: keep the original
#. stream container as-is, keep the original audio codec but strip non-audio
#. data, or convert to MP3 (continues for the next two lines).
#: addon\globalPlugins\freeAudio\settingsPanel.py:578
msgid "Original stream format (no conversion)"
msgstr "Formato de transmissão original (sem conversão)"

#: addon\globalPlugins\freeAudio\settingsPanel.py:579
msgid "Audio only, original codec (no quality loss)"
msgstr "Apenas áudio, codec original (sem perda de qualidade)"

#: addon\globalPlugins\freeAudio\settingsPanel.py:580
msgid "MP3 (convert audio)"
msgstr "MP3 (converter áudio)"

#. Translators: Label for the MP3 bitrate choice, shown only when MP3 output is
#. selected above.
#: addon\globalPlugins\freeAudio\settingsPanel.py:590
msgid "MP3 recording bitrate:"
msgstr "Taxa de bits da gravação MP3:"

#. Translators: Checkbox label for skipping the pre-playback internet
#. reachability check.
#: addon\globalPlugins\freeAudio\settingsPanel.py:607
msgid ""
"&Disable internet connectivity check before playing (recommended if DNS is "
"blocked)"
msgstr ""
"&Desativar a verificação de conectividade à Internet antes de reproduzir "
"(recomendado se o DNS estiver bloqueado)"

#. Translators: Checkbox label for the automatic update-check setting.
#: addon\globalPlugins\freeAudio\settingsPanel.py:618
msgid "&Automatically check for updates on startup"
msgstr "&Verificar automaticamente atualizações no arranque"

#. Translators: Button label; triggers an immediate manual update check.
#. Translators: Restores the button's normal label once the manual update check
#. finishes.
#: addon\globalPlugins\freeAudio\settingsPanel.py:626
#: addon\globalPlugins\freeAudio\settingsPanel.py:782
msgid "Check for Updates &Now"
msgstr "Verificar Atualizações &Agora"

#. Translators: Title of the file-picker dialog for choosing ffmpeg.exe.
#: addon\globalPlugins\freeAudio\settingsPanel.py:758
msgid "Select ffmpeg.exe"
msgstr "Selecionar ffmpeg.exe"

#. Translators: Temporary label on the Check for Updates Now button while the
#. check is in progress.
#: addon\globalPlugins\freeAudio\settingsPanel.py:769
msgid "Checking..."
msgstr "A verificar..."

#. Use _notify so the message is suppressed when notifications are muted.
#. Translators: Spoken when a sleep timer fires and stops playback instantly
#. (nothing was playing to fade out).
#. Use _notify so the stop message is suppressed when notifications are muted.
#. Translators: Spoken at the end of the fade-out, once volume has reached 0
#. and playback actually stops.
#: addon\globalPlugins\freeAudio\timerManager.py:219
#: addon\globalPlugins\freeAudio\timerManager.py:247
msgid "Sleep timer: radio stopped"
msgstr "Temporizador de suspensão: rádio parado"

#. Use _notify so both fade-out messages are suppressed when notifications are
#. muted.
#. Translators: Spoken when a sleep timer fires while something is playing,
#. before the 60-second volume fade-out begins.
#: addon\globalPlugins\freeAudio\timerManager.py:231
msgid "Sleep timer: fading out…"
msgstr "Temporizador de suspensão: a diminuir o volume…"

#. Translators: Spoken after a podcast/audiobook seek to report the resulting
#. position; see this method's docstring above for why the wording is shared
#. with TrackInfoMixin.script_whatsPlaying().
#. Translators: Appended to the What's Playing announcement for a
#. podcast/audiobook; same elapsed/remaining wording as
#. TimeshiftMixin._announce_seek_position().
#. Translators: Same elapsed/remaining wording as the playing-state
#. announcement, appended here when paused with a known total length.
#. Translators: Same elapsed/remaining wording as script_whatsPlaying, appended
#. here for a podcast/audiobook.
#. Translators: Same elapsed/remaining wording as script_whatsPlaying's paused
#. case.
#. Translators: Same elapsed/remaining wording as elsewhere, appended here for
#. a podcast/audiobook.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:94
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:179
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:214
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:491
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:517
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:694
#, python-format
msgid "%(elapsed)s elapsed, %(remaining)s remaining"
msgstr "%(elapsed)s decorridos, %(remaining)s restantes"

#. Translators: Same position announcement as above, used when the total length
#. isn't known so only elapsed time can be reported.
#. Translators: Same elapsed-only wording as _announce_seek_position()'s no-
#. length case, appended here when paused with an unknown total length.
#. Translators: Same elapsed-only wording as script_whatsPlaying's paused case.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:99
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:220
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:523
#, python-format
msgid "%(elapsed)s elapsed"
msgstr "%(elapsed)s decorridos"

#. Translators: Spoken if seeking to the start of an audio-book part/jukebox
#. track (the boundary clamp itself) fails.
#. No dedicated "Start of track" wording here - the elapsed/
#. remaining position _announce_seek_position() reports (0:00
#. elapsed) already makes that obvious on its own. Its
#. only-if-unavailable fallback reuses the same generic wording
#. the failure case above already uses.
#. Translators: Fallback spoken if _announce_seek_position() can't report a
#. position after seeking to the start/end of an audio-book part or jukebox
#. track.
#. Translators: Spoken if a plain (non-boundary) podcast/audiobook seek fails.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:184
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:192
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:214
msgid "Could not seek"
msgstr "Não foi possível avançar/recuar"

#. Translators: Fallback spoken only if _announce_seek_position() can't report
#. a position; %d is the number of seconds seeked.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:218
#, python-format
msgid "Forwarded %d seconds"
msgstr "Avançados %d segundos"

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:219
#, python-format
msgid "Rewound %d seconds"
msgstr "Recuados %d segundos"

#. Translators: Name of an NVDA command (Ctrl+Win+J); rewinds the live time-
#. shift buffer, or seeks backward within a podcast/audiobook file if one is
#. playing.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:311
msgid ""
"Time-shift: rewind 15 seconds (enters time-shift mode if not already active)"
msgstr ""
"Time-shift: recuar 15 segundos (entra no modo time-shift se não estiver já "
"ativo)"

#. Translators: Spoken when Ctrl+Win+J (rewind) is pressed while the time-shift
#. feature itself is turned off in settings.
#. Translators: Same message as the rewind command, spoken here when Ctrl+Win+K
#. (forward) is pressed with time-shift turned off.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:325
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:336
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:365
msgid "Time-shift buffer is disabled. Enable it in freeAudio settings."
msgstr ""
"O buffer de time-shift está desativado. Ative-o nas definições do freeAudio."

#. Translators: One of the reasons a rewind/forward can fail, mapped from
#. rewind_timeshift()'s return reason to a spoken message (continues for the
#. next six lines: feature disabled, wrong backend, HLS unsupported, not enough
#. buffer yet, buffer file not ready, engine error).
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:335
msgid ""
"Time-shift requires the BASS audio backend, which is currently disabled."
msgstr ""
"O time-shift requer o backend de áudio BASS, que está atualmente desativado."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:337
msgid "Time-shift is not available for the current playback backend."
msgstr "O time-shift não está disponível para o backend de reprodução atual."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:338
msgid ""
"Time-shift is not supported for this station's stream (no seekable audio "
"could be extracted)."
msgstr ""
"O time-shift não é suportado para a transmissão desta estação (não foi "
"possível extrair áudio pesquisável)."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:339
msgid ""
"Not enough buffered audio to rewind yet. Wait a few seconds after the station"
" starts playing and try again."
msgstr ""
"Ainda não há áudio em buffer suficiente para recuar. Aguarde alguns segundos "
"após a estação começar a reproduzir e tente novamente."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:340
msgid "Time-shift buffer file is not ready yet."
msgstr "O ficheiro de buffer do time-shift ainda não está pronto."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:341
msgid "Could not switch to time-shifted playback."
msgstr "Não foi possível mudar para a reprodução com time-shift."

#. Translators: Generic fallback spoken if the rewind fails for a reason not
#. covered by the specific messages above.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:344
msgid "Could not rewind"
msgstr "Não foi possível recuar"

#. Translators: Spoken after a successful rewind, reporting how far behind live
#. the buffer now is; %.0f is the number of seconds.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:347
#, python-format
msgid "Rewound to %.0f seconds behind live"
msgstr "Recuado para %.0f segundos antes do direto"

#. Translators: Name of an NVDA command (Ctrl+Win+K); fast-forwards the live
#. time-shift buffer (snapping to live once caught up), or seeks forward within
#. a podcast/audiobook file if one is playing.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:351
msgid ""
"Time-shift: fast-forward 15 seconds, or return to live if already caught up"
msgstr "Time-shift: avançar 15 segundos, ou regressar ao direto se já alcançou"

#. Translators: Spoken when fast-forward is pressed but playback is already at
#. the live edge (not time-shifted).
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:369
msgid "Already listening live"
msgstr "Já está a ouvir em direto"

#. Translators: Generic fallback spoken if the fast-forward operation fails.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:375
msgid "Could not fast-forward"
msgstr "Não foi possível avançar rapidamente"

#. Translators: Spoken when a fast-forward catches all the way up to the live
#. edge.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:379
msgid "Back to live"
msgstr "Voltar ao direto"

#. Translators: Spoken after a fast-forward that has not yet caught up to live;
#. %.0f is how many seconds behind live remain.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:383
#, python-format
msgid "Fast-forwarded, still %.0f seconds behind live"
msgstr "Avançado, ainda %.0f segundos antes do direto"

#. Translators: Name of an NVDA command (Ctrl+Win+T); toggles the time-shift
#. buffer feature on/off.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:388
msgid "Enable or disable the time-shift (rewind) buffer"
msgstr "Ativar ou desativar o buffer de time-shift (recuo)"

#. Translators: Spoken after toggling the time-shift buffer; the
#. 'enabled'/'disabled' word is the same one used throughout freeAudio's other
#. toggle announcements.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:413
#, python-format
msgid "Time-shift buffer %s"
msgstr "Buffer de time-shift %s"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:108
#, python-format
msgid "Recognition failed: %s"
msgstr "Reconhecimento falhou: %s"

#. Translators: Name of an NVDA command (Ctrl+Win+I); its behaviour escalates
#. with repeated presses as the description itself explains.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:120
msgid ""
"Announce currently playing station. Press twice for full details, three times"
" to copy track info, four times to force music recognition."
msgstr ""
"Anunciar a estação em reprodução. Prima duas vezes para detalhes completos, "
"três vezes para copiar informações da faixa, quatro vezes para forçar o "
"reconhecimento de música."

