#. declarations, which are rejected as a security measure against entity-
#. expansion attacks.
#: addon\globalPlugins\freeAudio\librivox.py:545
msgid "The feed contains XML entity declarations and was rejected."
msgstr "O feed contém declarações de entidade XML e foi rejeitado."

#. Translators: Error returned when the book's LibriVox RSS feed could not be
#. fetched or parsed.
#: addon\globalPlugins\freeAudio\librivox.py:555
msgid "Could not read this book's chapter list."
msgstr "Não foi possível ler a lista de capítulos deste livro."

