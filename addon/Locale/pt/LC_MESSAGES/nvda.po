#. Translators: Field-name row header for the track's channel count
#. (mono/stereo/etc.).
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:907
msgid "Channels"
msgstr "Canais"

#. Translators: Field-name row header for the track's bit depth; value has its
#. own %d-based unit string.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:912
msgid "Bit depth"
msgstr "Profundidade de bits"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:912
