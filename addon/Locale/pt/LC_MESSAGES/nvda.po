#. Translators: Error returned by resolve_media() when the book has no linked
#. archive.org item id, so no audio files can be looked up.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:401
msgid "This book has no archive.org item to read audio files from."
msgstr ""
"Este livro não tem um item no archive.org de onde ler ficheiros de áudio."

