#. match archive.org's book-details link pattern.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:424
#: addon\globalPlugins\freeAudio\librivox.py:418
msgid "This doesn't look like an archive.org book link."
msgstr "Isto não parece ser uma ligação para um livro do archive.org."

#. Translators: Error returned when the archive.org identifier from a pasted
#. link does not resolve to any item at all.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:443
#: addon\globalPlugins\freeAudio\librivox.py:437
msgid "Could not find a book at this address on archive.org."
msgstr "Não foi possível encontrar um livro neste endereço no archive.org."

#. Translators: Error returned when the resolved archive.org item exists but
#. isn't tagged as part of this specific audiobook collection.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:451
msgid ""
"This archive.org item isn't part of the Project Gutenberg Open Audiobook "
"Collection."
msgstr ""
"Este item do archive.org não faz parte da Coleção Aberta de Audiolivros do "
"Projeto Gutenberg."

#. Translators: Error returned by the chapter-listing step when archive.org has
#. no playable audio file for the resolved book.
#. Translators: Error returned by the archive.org metadata path when no
#. playable audio file was found for the resolved book.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:514
#: addon\globalPlugins\freeAudio\librivox.py:498
msgid "No playable audio file was found for this book on archive.org."
msgstr ""
"Não foi encontrado nenhum ficheiro de áudio reproduzível para este livro no "
"archive.org."

#. Translators: Raised internally when a chapter/book download completes but
