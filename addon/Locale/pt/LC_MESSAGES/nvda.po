msgstr "Notificações silenciadas"

#. Translators: Spoken when notifications are turned back on.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:47
msgid "Notifications unmuted"
msgstr "Notificações reativadas"

#. Translators: Name of an NVDA command; toggles whether freeAudio announces a
#. station's track/song changes from ICY stream metadata.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:53
msgid "Enable or disable auto-announce track changes (ICY metadata)"
msgstr ""
"Ativar ou desativar o anúncio automático de mudanças de faixa (metadados ICY)"

