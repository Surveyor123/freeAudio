msgid "freeAudio"
msgstr "freeAudio"

#. Translators: Spoken when no audio output devices could be found on the
#. system at all.
#. Translators: Spoken when no output devices are found while setting up audio
#. mirroring.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:57
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:191
msgid "No audio output devices found"
msgstr "Nenhum dispositivo de saída de áudio encontrado"

#. Translators: Spoken instead of showing a picker, when only one physical
#. audio output device exists.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:63
msgid ""
"Only one physical audio output device is available. freeAudio uses the system"
" default output."
msgstr ""
"Apenas um dispositivo físico de saída de áudio está disponível. O freeAudio "
"utiliza a saída predefinida do sistema."

#. Translators: First entry in the output-device list; means 'use whatever
#. Windows currently has as its default output'.
#. Translators: Same meaning as 'System default' above; label shown when
#. announcing the currently active output device.
#. Translators: Same 'System default' first-entry convention as the main
#. output-device picker (see audioDeviceMixin.py), used here to populate this
#. dialog's own device list.
#. Translators: Same 'System default' first-entry convention as the other
#. device pickers, used here to populate the Settings panel's device list.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:71
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:159
#: addon\globalPlugins\freeAudio\obligatoMixin.py:95
#: addon\globalPlugins\freeAudio\radioDialog.py:1710
#: addon\globalPlugins\freeAudio\settingsPanel.py:655
msgid "System default"
msgstr "Predefinição do sistema"

#. Translators: Prompt of the dialog listing devices to choose as freeAudio's
#. main playback output.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:96
msgid "Select the main output device:"
msgstr "Selecione o dispositivo de saída principal:"

#. Translators: Title of the dialog for choosing freeAudio's main output
#. device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:98
msgid "freeAudio Output Device"
msgstr "Dispositivo de saída do freeAudio"

#. Translators: Spoken when switching the main output device fails; %s is the
#. device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:123
#, python-format
msgid "Could not switch to output device: %s"
msgstr "Não foi possível mudar para o dispositivo de saída: %s"

#. Translators: Spoken after successfully switching the main output device; %s
#. is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:161
#, python-format
msgid "Output device: %s"
msgstr "Dispositivo de saída: %s"

#. Translators: Name of an NVDA command in the Input Gestures dialog;
#. starts/stops simultaneously playing audio through a second output device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:165
msgid "Mirror audio to an additional output device"
msgstr "Espelhar áudio para um dispositivo de saída adicional"

#. Translators: Spoken when audio mirroring to a secondary device is turned
#. off.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:174
msgid "Audio mirror stopped"
msgstr "Espelhamento de áudio parado"

#. Translators: Spoken if the user tries to start audio mirroring while nothing
#. is playing.
#. Translators: Spoken when the delayed single-press action fires and finds
#. nothing is playing.
#. Translators: Spoken when the double-press (song-capture) gesture is used
#. while nothing is playing.
#. Translators: Spoken when this shortcut is pressed while nothing is playing.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:179
#: addon\globalPlugins\freeAudio\recordingMixin.py:116
#: addon\globalPlugins\freeAudio\recordingMixin.py:238
#: addon\globalPlugins\freeAudio\__init__.py:1023
msgid "No station is playing"
msgstr "Não está a ser reproduzida nenhuma estação"

#. Translators: Prompt of the dialog for choosing the secondary (mirror) output
#. device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:206
msgid "Select additional output device for audio mirror:"
msgstr ""
"Selecione o dispositivo de saída adicional para o espelhamento de áudio:"

#. Translators: Title of the dialog for choosing the secondary mirror output
#. device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:208
msgid "Mirror Audio"
msgstr "Espelhar áudio"

#. Translators: Spoken once mirroring to the chosen secondary device starts
#. successfully; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:237
#, python-format
msgid "Mirroring to: %s"
msgstr "A espelhar para: %s"

#. Translators: Spoken when starting the audio mirror to the chosen device
#. fails; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:240
#, python-format
msgid "Could not mirror to: %s"
msgstr "Não foi possível espelhar para: %s"

#. Translators: Spoken automatically when the user's selected output device is
#. unplugged; freeAudio has fallen back to the system default.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:273
msgid "Audio device disconnected. Switched to system default."
msgstr "Dispositivo de áudio desligado. Mudou para a predefinição do sistema."

#. Translators: Name of an NVDA command; raises freeAudio's playback volume by
#. 5 (of 200 max, capped at 100 when saved).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:33
msgid "Increase freeAudio volume by 5"
msgstr "Aumentar o volume do freeAudio em 5"

#. Translators: Spoken after volume is changed with the volume-up/down
#. commands; %d is the new volume level.
#. Translators: Spoken after volume is changed; %d is the new volume level.
#. Translators: Spoken when F5 (volume down) is pressed inside the dialog; %d
#. is the new volume level. Same wording as the main volumeDown NVDA command.
#. Translators: Spoken when F6 (volume up) is pressed inside the dialog; %d is
#. the new volume level. Same wording as the main volumeUp NVDA command.
#. Translators: Spoken when Ctrl+Up (volume up) is pressed inside the dialog on
#. a focused control that doesn't otherwise handle it; %d is the new volume
#. level. Same wording as the main volumeUp NVDA command.
#. Translators: Spoken when Ctrl+Down (volume down) is pressed inside the
#. dialog; %d is the new volume level. Same wording as the main volumeDown NVDA
#. command.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:42
#: addon\globalPlugins\freeAudio\audioFxMixin.py:56
#: addon\globalPlugins\freeAudio\radioDialog.py:4079
#: addon\globalPlugins\freeAudio\radioDialog.py:4093
#: addon\globalPlugins\freeAudio\radioDialog.py:4274
#: addon\globalPlugins\freeAudio\radioDialog.py:4282
#, python-format
msgid "Volume %d"
msgstr "Volume %d"

#. Translators: Name of an NVDA command; lowers freeAudio's playback volume by
#. 5.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:47
msgid "Decrease freeAudio volume by 5"
msgstr "Diminuir o volume do freeAudio em 5"

#. Translators: Name of an NVDA command; speeds up playback rate,
#. podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:61
msgid "Increase podcast playback speed"
msgstr "Aumentar a velocidade de reprodução do podcast"

#. Translators: Name of an NVDA command; slows down playback rate,
#. podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:70
msgid "Decrease podcast playback speed"
msgstr "Diminuir a velocidade de reprodução do podcast"

#. Translators: Spoken when the playback-rate command returns the rate to
#. normal (1.0x).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:81
msgid "Rate normal"
msgstr "Velocidade normal"

#. Translators: Spoken after changing playback rate; %.1f is the new rate, e.g.
#. '1.5' meaning 1.5x speed.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:84
#, python-format
msgid "Rate %.1f"
msgstr "Velocidade %.1f"

#. Translators: Spoken when playback-rate change fails because the optional
#. bass_fx library used for time-stretching isn't installed.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:88
msgid ""
"Playback speed control needs the bass_fx add-on library — see the freeAudio "
"docs."
msgstr ""
"O controlo da velocidade de reprodução necessita da biblioteca bass_fx — veja"
" a documentação do freeAudio."

#. Translators: Spoken when the user tries to change playback rate while
#. playing a live radio station rather than a podcast/audiobook.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:91
msgid "Playback speed control is only available for podcasts."
msgstr ""
"O controlo da velocidade de reprodução está disponível apenas para podcasts."

#. Translators: Generic fallback spoken when the playback-rate change fails for
#. an unrecognised reason.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:94
msgid "Could not change playback speed."
msgstr "Não foi possível alterar a velocidade de reprodução."

#. Translators: Name of an NVDA command; toggles a low-frequency EQ boost
#. on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:132
msgid "Toggle bass boost"
msgstr "Ativar/desativar o reforço de graves"

#. Translators: Short label used in the 'X enabled/disabled' announcement (see
#. _toggle_eq_band) when toggling the bass-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:138
#: addon\globalPlugins\freeAudio\radioDialog.py:778
#: addon\globalPlugins\freeAudio\settingsPanel.py:181
msgid "EQ: Bass Boost"
msgstr "EQ: Reforço de Graves"

#. Translators: Name of an NVDA command; toggles a high-frequency EQ boost
#. on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:142
msgid "Toggle treble boost"
msgstr "Ativar/desativar o reforço de agudos"

#. Translators: Short label used in the 'X enabled/disabled' announcement when
#. toggling the treble-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:148
#: addon\globalPlugins\freeAudio\radioDialog.py:778
#: addon\globalPlugins\freeAudio\settingsPanel.py:182
msgid "EQ: Treble Boost"
msgstr "EQ: Reforço de Agudos"

#. Translators: Name of an NVDA command; toggles a mid-range EQ boost tuned for
#. vocal clarity on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:152
msgid "Toggle vocal boost"
msgstr "Ativar/desativar o reforço vocal"

#. Translators: Short label used in the 'X enabled/disabled' announcement when
#. toggling the vocal-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:158
#: addon\globalPlugins\freeAudio\radioDialog.py:778
#: addon\globalPlugins\freeAudio\settingsPanel.py:183
msgid "EQ: Vocal Boost"
msgstr "EQ: Reforço Vocal"

#. Translators: Announcement after toggling an EQ band; %(effect)s is one of
#. the 'EQ: ... Boost' labels above, %(state)s is 'enabled'/'disabled' below.
#. Translators: Announcement after toggling; %(effect)s is the plain-text
#. feature name below (with its '&' access-key marker stripped), %(state)s is
#. 'enabled'/'disabled'.
#. Translators: Same toggle-announcement pattern as
#. script_toggleAnnounceTrackChanges above.
#. Translators: Effect on/off status spoken when hovering over an item in the
#. Effects checklist; %(effect)s is the effect name, %(state)s the
#. enabled/disabled word below.
#. Translators: Same effect on/off announcement as _on_fx_focus above, spoken
#. here after actually toggling the effect (checklist click).
#. Translators: Same effect on/off announcement, spoken here after toggling via
#. the Ctrl+1..Ctrl+0 keyboard shortcuts.
#. Translators: Same "%(effect)s %(state)s" announcement pattern as
#. radioDialog.py's _toggle_eq_band; spoken here when hovering an item in the
#. Settings effects checklist. %(state)s is "enabled"/"disabled" below.
#. Translators: Same announcement as the hover handler above, spoken here after
#. actually toggling an effect via the checklist checkbox.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:221
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:76
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:125
#: addon\globalPlugins\freeAudio\radioDialog.py:1795
#: addon\globalPlugins\freeAudio\radioDialog.py:1808
#: addon\globalPlugins\freeAudio\radioDialog.py:1833
#: addon\globalPlugins\freeAudio\settingsPanel.py:702
#: addon\globalPlugins\freeAudio\settingsPanel.py:714
#, python-format
msgid "%(effect)s %(state)s"
msgstr "%(effect)s %(state)s"

#. Translators: Second half of the 'X enabled/disabled' announcement in
#. _toggle_eq_band; describes the EQ band's new on/off state.
#. Translators: Second half of the toggle announcement above; describes the
#. feature's new on/off state.
#. Translators: Second half of the toggle announcement; describes the feature's
#. new on/off state.
#. Translators: The two possible %(state)s values above, and in the two other
#. identical announcements in _on_fx_changed/_toggle_fx_by_index below.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:224
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:80
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:129
#: addon\globalPlugins\freeAudio\radioDialog.py:1798
#: addon\globalPlugins\freeAudio\radioDialog.py:1810
#: addon\globalPlugins\freeAudio\radioDialog.py:1835
#: addon\globalPlugins\freeAudio\settingsPanel.py:704
#: addon\globalPlugins\freeAudio\settingsPanel.py:716
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:413
msgid "enabled"
msgstr "ativado"

#: addon\globalPlugins\freeAudio\audioFxMixin.py:224
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:80
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:129
#: addon\globalPlugins\freeAudio\radioDialog.py:1798
#: addon\globalPlugins\freeAudio\radioDialog.py:1810
#: addon\globalPlugins\freeAudio\radioDialog.py:1835
#: addon\globalPlugins\freeAudio\settingsPanel.py:704
#: addon\globalPlugins\freeAudio\settingsPanel.py:716
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:413
msgid "disabled"
msgstr "desativado"

#. Translators: Name of an NVDA command; cycles the sound effect played when
#. switching stations (crossfade/instant cut/tuning effect).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:229
msgid "Toggle station switch transition (crossfade)"
msgstr "Ativar/desativar a transição entre estações (crossfade)"

#. Translators: One of the station-transition modes cycled by the crossfade
#. command: plays no transition sound, cuts instantly.
#. Translators: Choices for the crossfade setting, same wording and order as
#. the in-app toggleStationTransition command's cycle (audioFxMixin.py) -
#. continues for the next three lines.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:237
#: addon\globalPlugins\freeAudio\settingsPanel.py:226
msgid "Instant cut (no crossfade)"
msgstr "Corte instantâneo (sem crossfade)"

#. Translators: One of the station-transition modes: a brief 1-second audio
#. crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:239
#: addon\globalPlugins\freeAudio\settingsPanel.py:227
msgid "Short crossfade (1 second)"
msgstr "Crossfade curto (1 segundo)"

#. Translators: One of the station-transition modes: a longer 2-second audio
#. crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:241
#: addon\globalPlugins\freeAudio\settingsPanel.py:228
msgid "Normal crossfade (2 seconds)"
msgstr "Crossfade normal (2 segundos)"

#. Translators: One of the station-transition modes: plays a radio-tuning sound
#. effect instead of a crossfade.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:243
#: addon\globalPlugins\freeAudio\settingsPanel.py:229
msgid "Station tuning sound effect"
msgstr "Efeito sonoro de sintonia da estação"

#. Translators: Fallback catalog-search result title when GETEM returns no
#. usable link text.
#. Translators: Fallback GetemBook.title when no title was supplied at
#. construction.
#. Translators: Fallback GetemBook.title when the detail page has no parseable
#. title element.
#. Translators: Fallback book title when archive.org returns no title metadata
#. for a search result.
#. Translators: Fallback GutenbergAudiobook.title when no title was supplied at
#. construction.
#. Translators: Fallback book title when archive.org returns no title metadata
#. for a search result.
#. Translators: Fallback LibrivoxBook.title when no title was supplied at
#. construction.
#. Translators: Fallback station name (used only for the confirmation message
#. below) if the station has no name field at all.
#. Translators: Fallback station name when a station dict has none.
#: addon\globalPlugins\freeAudio\getem.py:430
#: addon\globalPlugins\freeAudio\getem.py:460
#: addon\globalPlugins\freeAudio\getem.py:1133
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:190
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:286
#: addon\globalPlugins\freeAudio\librivox.py:160
#: addon\globalPlugins\freeAudio\librivox.py:257
#: addon\globalPlugins\freeAudio\radioDialog.py:3692
#: addon\globalPlugins\freeAudio\utils.py:338
msgid "Unknown"
msgstr "Desconhecido"

#. Translators: Fixed source label for GETEM audiobooks, shown in the station-
#. details dialog and the Audio Books tab (same role as
#. gutenberg_audiobooks.py's 'audiobook_source').
#. Translators: Source-name label for a book from GETEM (Boğaziçi University
#. audio e-library) - the fallback when the book is neither LibriVox nor
#. Project Gutenberg.
#. Reuses the exact same bare "GETEM"/"LibriVox"/"Project Gutenberg"
#. strings RadioDialog._audiobook_source_label_for() already shows
#. next to each book in the Audio Books tab, rather than
#. introducing new, differently-worded translations for the same
#. three names.
#. Translators: Names in the audio-book-sources checklist below; see the
#. comment above for why these reuse RadioDialog's existing source-label
#. strings rather than new translations.
#: addon\globalPlugins\freeAudio\getem.py:568
#: addon\globalPlugins\freeAudio\radioDialog.py:7170
#: addon\globalPlugins\freeAudio\settingsPanel.py:523
msgid "GETEM"
msgstr "GETEM"

#. Translators: Error returned by GetemSession.login() when freeAudio has no
#. saved GETEM credentials at all.
#: addon\globalPlugins\freeAudio\getem.py:652
msgid "Please enter your GETEM username and password in freeAudio's settings."
msgstr ""
"Introduza o seu nome de utilizador e palavra-passe GETEM nas definições do "
"freeAudio."

#. Translators: Error returned by GetemSession.login() when the GETEM server
#. rejects the saved username/password.
#: addon\globalPlugins\freeAudio\getem.py:686
msgid "GETEM login failed. Please check your username and password."
msgstr ""
"Falha no início de sessão GETEM. Verifique o seu nome de utilizador e "
"palavra-passe."

#. Translators: Error returned before attempting login when the settings
#. dialog's GETEM username/password fields are empty.
#: addon\globalPlugins\freeAudio\getem.py:720
msgid ""
"Please enter your GETEM username and password in freeAudio's settings first."
msgstr ""
"Introduza primeiro o seu nome de utilizador e palavra-passe GETEM nas "
"definições do freeAudio."

#. Translators: Error returned by search_getem() when the user submits an empty
#. search box.
#. Translators: Error returned by search_gutenberg_audiobooks() when the user
#. submits an empty search box.
#. Translators: Error returned by search_librivox() when the user submits an
#. empty search box.
#. Translators: Spoken when the search button/enter is used with an empty
#. search box.
#. Translators: Spoken when the jukebox device-search is used with an empty
#. search box.
#: addon\globalPlugins\freeAudio\getem.py:756
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:231
#: addon\globalPlugins\freeAudio\librivox.py:197
#: addon\globalPlugins\freeAudio\radioDialog.py:7411
#: addon\globalPlugins\freeAudio\radioDialog.py:8522
msgid "Please enter a search term."
msgstr "Introduza um termo de pesquisa."

#. Translators: Error returned by search_getem() when the GETEM catalog page
#. itself could not be fetched (network failure).
#: addon\globalPlugins\freeAudio\getem.py:763
msgid "Could not reach GETEM's catalog. Please check your internet connection."
msgstr ""
"Não foi possível aceder ao catálogo do GETEM. Verifique a sua ligação à "
"Internet."

#. Translators: Fallback chapter title for a multi-part work whose parts have
#. no individual names; '{0}' is the book title, '{1}' the 1-based part number.
#: addon\globalPlugins\freeAudio\getem.py:886
msgid "{0} - Part {1}"
msgstr "{0} - Parte {1}"

#: addon\globalPlugins\freeAudio\getem.py:924
#: addon\globalPlugins\freeAudio\getem.py:1151
msgid ""
"No playable audio file was found on this work's GETEM page. It may require "
"manual download from the site."
msgstr ""
"Não foi encontrado nenhum ficheiro de áudio reproduzível na página GETEM "
"desta obra. Pode ser necessário descarregá-lo manualmente do site."

#. Translators: Error returned by get_book_by_url() when the pasted URL doesn't
#. look like a GETEM work page link.
#: addon\globalPlugins\freeAudio\getem.py:1115
msgid "This doesn't look like a GETEM work link."
msgstr "Isto não parece ser uma ligação para uma obra do GETEM."

#. Translators: Raised when a chapter download completes but produced a zero-
#. byte file, usually because the GETEM session was not actually logged in.
#: addon\globalPlugins\freeAudio\getem.py:1249
msgid "The downloaded file was empty. Please check your GETEM login."
msgstr ""
"O ficheiro descarregado está vazio. Verifique o seu início de sessão GETEM."

#. Translators: Raised when the URL fetched for a chapter returns a response
