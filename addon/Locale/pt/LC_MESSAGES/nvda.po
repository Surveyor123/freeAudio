msgstr "Pasta não encontrada: %s"

#. Translators: Error returned by JukeboxManager.add_folder() when the folder
#. was scanned but contains no recognized audio files.
#: addon\globalPlugins\freeAudio\jukebox.py:1236
msgid "No audio files found in that folder."
msgstr "Nenhum ficheiro de áudio encontrado nessa pasta."

#: addon\globalPlugins\freeAudio\jukebox.py:1347
msgid "Not a valid jukebox export file."
msgstr "Não é um ficheiro de exportação de jukebox válido."

#: addon\globalPlugins\freeAudio\jukebox.py:1397
msgid "Not a valid M3U playlist file."
msgstr "Não é um ficheiro de lista de reprodução M3U válido."

#: addon\globalPlugins\freeAudio\legacyMigration.py:179
msgid ""
"The previous version of this add-on, FreeRadio, is still installed alongside "
"freeAudio. Running both at the same time makes them compete for the same "
"shortcuts and audio device. Your settings and data have been copied to "
"freeAudio. Please uninstall FreeRadio (NVDA menu, Tools, Add-on Store or "
"Manage add-ons) and restart NVDA."
msgstr ""
"A versão anterior deste complemento, FreeRadio, ainda está instalada em "
"conjunto com o freeAudio. Executar ambos ao mesmo tempo fá-los competir pelos"
" mesmos atalhos e pelo mesmo dispositivo de áudio. As suas definições e dados"
" foram copiados para o freeAudio. Desinstale o FreeRadio (menu NVDA, "
"Ferramentas, Loja de complementos ou Gerir complementos) e reinicie o NVDA."

#. Translators: Fixed source label for LibriVox audiobooks, shown in the
#. station-details dialog and the Audio Books tab (same role as
#. getem.py's/gutenberg_audiobooks.py's 'audiobook_source').
