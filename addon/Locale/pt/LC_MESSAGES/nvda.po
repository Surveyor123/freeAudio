#: addon\globalPlugins\freeAudio\radioDialog.py:9413
msgid "&Rescan Folder"
msgstr "&Reanalisar Pasta"

#. Translators: Title of the lyrics dialog; %s is the song string (e.g. "Artist - Title").
#: addon\globalPlugins\freeAudio\radioDialog.py:9464
#, python-format
msgid "Lyrics — %s"
msgstr "Letra — %s"

#. Translators: Heading inside the lyrics dialog restating which song the lyrics are for; %s is the song string.
#: addon\globalPlugins\freeAudio\radioDialog.py:9471
#, python-format
msgid "Lyrics for: %s"
msgstr "Letra para: %s"

#. Translators: Accessible name for the read-only lyrics text area.
#: addon\globalPlugins\freeAudio\radioDialog.py:9481
msgid "Lyrics"
msgstr "Letra"

#. Translators: Title of the dialog for manually adding a custom station by stream URL.
#: addon\globalPlugins\freeAudio\radioDialog.py:9511
msgid "Add Custom Station"
msgstr "Adicionar Estação Personalizada"

#. Translators: Label for the custom-station name field.
#: addon\globalPlugins\freeAudio\radioDialog.py:9515
msgid "Station name:"
msgstr "Nome da estação:"

#. Translators: Label for the custom-station stream-URL field.
#: addon\globalPlugins\freeAudio\radioDialog.py:9520
msgid "Stream URL:"
msgstr "URL de transmissão:"

#. Translators: Button label; opens Radio Browser's own website to submit this station to their public directory (separate from just adding it locally to freeAudio).
#: addon\globalPlugins\freeAudio\radioDialog.py:9534
msgid "Add to &Radio Browser directory…"
msgstr "Adicionar ao diretório do &Radio Browser…"

#. Translators: Button label; confirms and adds the custom station to favourites.
#: addon\globalPlugins\freeAudio\radioDialog.py:9539
msgid "&Add"
msgstr "&Adicionar"

#. Translators: Status text shown next to the Test URL button when it's pressed with an empty URL field.
#. Translators: Spoken alongside the status text above.
#: addon\globalPlugins\freeAudio\radioDialog.py:9562
#: addon\globalPlugins\freeAudio\radioDialog.py:9564
msgid "Please enter a URL first."
msgstr "Introduza um URL primeiro."

#. Translators: Status text shown next to the Test URL button while the check is in progress.
#: addon\globalPlugins\freeAudio\radioDialog.py:9568
msgid "Checking…"
msgstr "A verificar…"

#. Translators: Spoken when the URL check starts.
#: addon\globalPlugins\freeAudio\radioDialog.py:9570
msgid "Checking stream URL, please wait…"
msgstr "A verificar o URL da transmissão, aguarde…"

#. Translators: Status text shown next to the Test URL button when the stream checked out as playable; the '✓' is a visual checkmark, not meant to be read as punctuation.
#: addon\globalPlugins\freeAudio\radioDialog.py:9584
msgid "✓ Stream reachable"
msgstr "✓ Transmissão acessível"

#. Translators: Spoken when the stream check succeeds.
#: addon\globalPlugins\freeAudio\radioDialog.py:9587
msgid "Stream is reachable."
msgstr "A transmissão está acessível."

#. Translators: Status text shown when the stream check failed; the '✗' is a visual cross mark, %s is the specific error from check_stream_url().
#: addon\globalPlugins\freeAudio\radioDialog.py:9590
#, python-format
msgid "✗ %s"
msgstr "✗ %s"

#. Translators: Spoken when the stream check fails; %s is the specific error from check_stream_url().
#: addon\globalPlugins\freeAudio\radioDialog.py:9593
#, python-format
msgid "Stream check failed: %s"
msgstr "Falha na verificação da transmissão: %s"

#. Translators: Title of the dialog for editing an existing scheduled recording; %s is the station name.
#: addon\globalPlugins\freeAudio\radioDialog.py:9611
#, python-format
msgid "Edit Schedule — %s"
msgstr "Editar Agenda — %s"

#. Translators: 'Save' button label; commits the edited schedule entry.
#: addon\globalPlugins\freeAudio\radioDialog.py:9695
msgid "&Save"
msgstr "&Guardar"

#. Translators: Fallback episode title used for the downloaded filename if the currently playing episode has no name.
#. Translators: Field-name row header in this dialog's podcast-episode details table; value is the episode title.
#: addon\globalPlugins\freeAudio\recordingMixin.py:44
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:831
msgid "Episode"
msgstr "Episódio"

#. Translators: Spoken when trying to download the current podcast episode but it has no resolvable URL.
#: addon\globalPlugins\freeAudio\recordingMixin.py:48
msgid "This episode has no downloadable URL."
msgstr "Este episódio não tem URL para download."

#. Translators: Spoken when the user manually ends an in-progress song-capture recording (double-press Ctrl+Win+E while capturing); %s is the saved filename.
#: addon\globalPlugins\freeAudio\recordingMixin.py:112
#, python-format
msgid "Song recording stopped: %s"
msgstr "Gravação da música parada: %s"

#. Translators: Fallback spoken when song-capture is stopped but no output path was returned (e.g. nothing was actually captured).
#. Translators: Fallback spoken when auto-stop finds nothing to save (e.g. capture just started).
#: addon\globalPlugins\freeAudio\recordingMixin.py:116
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1192
msgid "Song recording stopped"
msgstr "Gravação da música parada"

#. Translators: Spoken when a recording of every song (triple-press Ctrl+Win+E) is stopped; %d is how many songs were saved.
#: addon\globalPlugins\freeAudio\recordingMixin.py:125
#, python-format
msgid "Song recording stopped. Songs saved: %d"
msgstr "Gravação de músicas parada. Músicas guardadas: %d"

#. Translators: Spoken when double-pressing Ctrl+Win+E (song-capture) on a podcast/audiobook episode, which can't be recorded this way; points to the Ctrl+Win+V download command instead.
#. Translators: Same message as the song-capture path above, spoken here when single-pressing Ctrl+Win+E on a podcast/audiobook episode.
#: addon\globalPlugins\freeAudio\recordingMixin.py:156
#: addon\globalPlugins\freeAudio\recordingMixin.py:323
msgid ""
"Podcast or audiobook cannot be recorded. To download the episode or book, "
"press Ctrl+Win+V."
msgstr ""
"Podcast ou audiolivro não podem ser gravados. Para descarregar o episódio ou "
"livro, prima Ctrl+Win+V."

#. Translators: Spoken when double-pressing Ctrl+Win+E (song-capture) on a jukebox track, which is already a local file.
#. Translators: Same message as the song-capture path above, spoken here when single-pressing Ctrl+Win+E on a jukebox track.
#: addon\globalPlugins\freeAudio\recordingMixin.py:165
#: addon\globalPlugins\freeAudio\recordingMixin.py:331
msgid "Jukebox tracks are already local files and cannot be recorded."
msgstr "As faixas do jukebox são já ficheiros locais e não podem ser gravadas."

#. Translators: Spoken when trying to start song-capture recording on a station with no ICY track-title metadata, so there's no song boundary to record against.
#: addon\globalPlugins\freeAudio\recordingMixin.py:183
msgid ""
"This station does not broadcast track metadata. Song recording is not "
"available."
msgstr ""
"Esta estação não transmite metadados de faixa. A gravação de música não está "
"disponível."

#. Translators: Spoken when recording every song (triple-press Ctrl+Win+E) is not possible on this station because its stream carries no track-change markers.
#: addon\globalPlugins\freeAudio\recordingMixin.py:192
msgid ""
"This station does not support recording every song. Double-press to record "
"the current song."
msgstr ""
"Esta estação não suporta a gravação de todas as músicas. Prima duas vezes "
"para gravar a música atual."

#. Translators: Generic fallback spoken if starting song-capture recording raises an unexpected exception.
#: addon\globalPlugins\freeAudio\recordingMixin.py:213
msgid "Could not start song recording"
msgstr "Não foi possível iniciar a gravação da música"

#. Translators: Spoken when song-capture recording starts; %s is the current ICY track title (artist/song) being captured.
#: addon\globalPlugins\freeAudio\recordingMixin.py:220
#, python-format
msgid "Song recording started: %s"
msgstr "Gravação da música iniciada: %s"

#. Translators: Spoken when recording every song starts (triple-press Ctrl+Win+E); %s is the current song's title.
#: addon\globalPlugins\freeAudio\recordingMixin.py:233
#, python-format
msgid "Recording every song until stopped. Current song: %s"
msgstr "A gravar todas as músicas até parar. Música atual: %s"

#. Translators: Name of an NVDA command (Ctrl+Win+E); single-press toggles a plain instant recording, double-press records the current song, triple-press records every song until stopped - see this method's logic below.
#: addon\globalPlugins\freeAudio\recordingMixin.py:238
msgid ""
"Start or stop instant recording. Press twice for current song recording, "
"thrice for recording every song."
msgstr ""
"Iniciar ou parar a gravação instantânea. Prima duas vezes para gravar a "
"música atual, três vezes para gravar todas as músicas."

#. Translators: Spoken when the single-press gesture stops an in-progress plain instant recording; %s is the saved filename.
#: addon\globalPlugins\freeAudio\recordingMixin.py:313
#, python-format
msgid "Recording stopped: %s"
msgstr "Gravação parada: %s"

#. Translators: Fallback spoken when a recording is stopped but no output path was returned.
#: addon\globalPlugins\freeAudio\recordingMixin.py:316
msgid "Recording stopped"
msgstr "Gravação parada"

#. Translators: Spoken when a plain instant recording starts (single-press Ctrl+Win+E); %s is the station name.
#. Translators: Spoken when a scheduled or manual recording begins; %s is the station name.
#: addon\globalPlugins\freeAudio\recordingMixin.py:343
#: addon\globalPlugins\freeAudio\__init__.py:594
#, python-format
msgid "Recording started: %s"
msgstr "Gravação iniciada: %s"

#. Translators: Generic fallback spoken if starting an instant recording raises an unexpected exception.
#: addon\globalPlugins\freeAudio\recordingMixin.py:347
msgid "Could not start recording"
msgstr "Não foi possível iniciar a gravação"

#. Translators: Name of an NVDA command (Ctrl+Win+W); opens the configured recordings folder in File Explorer.
#: addon\globalPlugins\freeAudio\recordingMixin.py:354
msgid "Open freeAudio recordings folder"
msgstr "Abrir a pasta de gravações do freeAudio"

#. Translators: Spoken when the Ctrl+Win+W shortcut can't open the recordings folder in Explorer; %s is the underlying error.
#: addon\globalPlugins\freeAudio\recordingMixin.py:369
#, python-format
msgid "Could not open recordings folder: %s"
msgstr "Não foi possível abrir a pasta de gravações: %s"

#. Translators: Check box in the clean-up dialog; resets freeAudio's settings to their defaults.
#: addon\globalPlugins\freeAudio\resetDialog.py:73
msgid ""
"Settings (reset to defaults; the recordings folder and the liked songs "
"option are kept)"
msgstr ""
"Definições (repostas para os valores predefinidos; a pasta de gravações e a "
"opção das músicas favoritas são mantidas)"

#. Translators: Check box in the clean-up dialog; deletes the favourite stations list.
#: addon\globalPlugins\freeAudio\resetDialog.py:79
msgid "Favorite stations"
msgstr "Estações favoritas"

#. Translators: Check box in the clean-up dialog; deletes the downloaded station list cache.
#: addon\globalPlugins\freeAudio\resetDialog.py:85
msgid "Station list cache (downloaded again when needed)"
msgstr "Cache da lista de estações (transferida de novo quando necessário)"

#. Translators: Check box in the clean-up dialog; deletes the audio book libraries of all sources.
#: addon\globalPlugins\freeAudio\resetDialog.py:97
msgid "Audio book libraries (GETEM, LibriVox, Project Gutenberg)"
msgstr "Bibliotecas de audiolivros (GETEM, LibriVox, Project Gutenberg)"

#. Translators: Check box in the clean-up dialog; deletes the saved GETEM user name and password.
#: addon\globalPlugins\freeAudio\resetDialog.py:107
msgid "Saved GETEM login"
msgstr "Credenciais do GETEM guardadas"

#. Translators: Check box in the clean-up dialog; empties the Jukebox list (the music files themselves are not touched).
#: addon\globalPlugins\freeAudio\resetDialog.py:113
msgid "Jukebox list (your music files are not deleted)"
msgstr "Lista do jukebox (os ficheiros de música não são eliminados)"

#. Translators: Check box in the clean-up dialog; deletes saved resume positions.
#: addon\globalPlugins\freeAudio\resetDialog.py:119
msgid "Saved resume positions (podcasts, audio books, Jukebox folders)"
msgstr ""
"Posições de retoma guardadas (podcasts, audiolivros, pastas do jukebox)"

#. Translators: Check box in the clean-up dialog; deletes all bookmarks of audio books, podcast episodes and jukebox tracks, including their voice notes.
#: addon\globalPlugins\freeAudio\resetDialog.py:128
msgid "Bookmarks (including their text and voice notes)"
msgstr "Marcadores (incluindo as notas de texto e de voz)"

#. Translators: Check box in the clean-up dialog; deletes sleep timers and alarms.
#: addon\globalPlugins\freeAudio\resetDialog.py:137
msgid "Sleep timers and alarms"
msgstr "Temporizadores de suspensão e alarmes"

#. Translators: Check box in the clean-up dialog; deletes the scheduled recording plans (not the recordings).
#: addon\globalPlugins\freeAudio\resetDialog.py:143
msgid "Scheduled recording plans (recordings themselves are not deleted)"
msgstr "Planos de gravação agendada (as próprias gravações não são eliminadas)"

#. Translators: Title of the clean-up dialog opened from freeAudio's settings.
#: addon\globalPlugins\freeAudio\resetDialog.py:269
msgid "Reset settings / delete saved data"
msgstr "Repor definições / eliminar dados guardados"

#. Translators: Added after a clean-up item's name when there is nothing saved for it.
#: addon\globalPlugins\freeAudio\resetDialog.py:286
msgid "nothing saved"
msgstr "nada guardado"

#. Translators: Label of the check list in the clean-up dialog.
#: addon\globalPlugins\freeAudio\resetDialog.py:291
msgid "Select what to reset or delete (nothing is selected by default):"
msgstr ""
"Selecione o que repor ou eliminar (por predefinição, nada está selecionado):"

#. Translators: Note in the clean-up dialog.
#: addon\globalPlugins\freeAudio\resetDialog.py:298
msgid "Recordings and liked songs are never touched by this."
msgstr "As gravações e as músicas favoritas nunca são tocadas."

#. Translators: Button in the clean-up dialog; checks every item.
#: addon\globalPlugins\freeAudio\resetDialog.py:303
msgid "Select &all"
msgstr "Selecionar &tudo"

#. Translators: Button in the clean-up dialog; resets/deletes the checked items.
#: addon\globalPlugins\freeAudio\resetDialog.py:306
msgid "&Reset / delete selected"
msgstr "&Repor / eliminar selecionados"

#. Translators: Button in the clean-up dialog; closes it without doing anything.
#. Translators: 'Cancel' button label on the update-available dialog, paired with whichever install/open-page label is used as the other button.
#: addon\globalPlugins\freeAudio\resetDialog.py:310
#: addon\globalPlugins\freeAudio\__init__.py:1623
msgid "&Cancel"
msgstr "&Cancelar"

#. Translators: Shown in the clean-up dialog when the reset/delete button is pressed with nothing checked.
#: addon\globalPlugins\freeAudio\resetDialog.py:343
msgid "Nothing is selected."
msgstr "Nada está selecionado."

#. Translators: Confirmation in the clean-up dialog. {items} is the list of checked items, one per line.
#: addon\globalPlugins\freeAudio\resetDialog.py:355
msgid ""
"The following will be reset or deleted. This cannot be undone.\n"
"\n"
"{items}\n"
"\n"
"Continue?"
msgstr ""
"Os elementos seguintes serão repostos ou eliminados. Esta ação não pode ser "
"anulada.\n"
"\n"
"{items}\n"
"\n"
"Continuar?"

#. Translators: Shown after the clean-up when some items could not be removed. {items} is the list, one per line.
#: addon\globalPlugins\freeAudio\resetDialog.py:372
msgid ""
"Done, except for the following, which could not be removed (a file may be in "
"use):\n"
"\n"
"{items}"
msgstr ""
"Concluído, exceto os elementos seguintes, que não foi possível remover (um "
"ficheiro pode estar em uso):\n"
"\n"
"{items}"

#. Translators: Shown after the clean-up finished without problems.
#: addon\globalPlugins\freeAudio\resetDialog.py:379
msgid "Done."
msgstr "Concluído."

#. Translators: Added to the clean-up result when settings were reset.
#: addon\globalPlugins\freeAudio\resetDialog.py:384
msgid ""
"Settings were reset. Changes made on the freeAudio settings page before this "
"will not be saved. Restarting NVDA is recommended so every setting takes "
"effect."
msgstr ""
"As definições foram repostas. As alterações feitas anteriormente na página "
"de definições do freeAudio não serão guardadas. Recomenda-se reiniciar o "
"NVDA para que todas as definições tenham efeito."

#. Translators: Checkbox label for the time-shift/rewind feature setting.
#: addon\globalPlugins\freeAudio\settingsPanel.py:89
msgid ""
"&Enable time-shift buffer (rewind live radio, no effect on podcasts and "
"audio books)"
msgstr ""
"&Ativar o buffer de time-shift (retroceder rádio ao vivo, sem efeito em "
"podcasts e audiolivros)"

#. Translators: Label for the time-shift buffer-length choice control.
#: addon\globalPlugins\freeAudio\settingsPanel.py:97
msgid "Time-shift buffer duration:"
msgstr "Duração do buffer de time-shift:"

#. Translators: Choices for the time-shift buffer-duration control, in the same order as self._timeshift_duration_seconds just above (continues on the next line).
#: addon\globalPlugins\freeAudio\settingsPanel.py:103
msgid "10 minutes"
msgstr "10 minutos"

#: addon\globalPlugins\freeAudio\settingsPanel.py:103
msgid "30 minutes"
msgstr "30 minutos"

#: addon\globalPlugins\freeAudio\settingsPanel.py:103
msgid "1 hour"
msgstr "1 hora"

#: addon\globalPlugins\freeAudio\settingsPanel.py:104
msgid "2 hours"
msgstr "2 horas"

#: addon\globalPlugins\freeAudio\settingsPanel.py:104
