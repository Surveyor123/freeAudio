#: addon\globalPlugins\freeAudio\librivox.py:621
msgid "The downloaded file was empty."
msgstr "O ficheiro descarregado está vazio."

#. Translators: %(name)s = folder name, %(count)d = number of audio files found
#. in it
#: addon\globalPlugins\freeAudio\jukebox.py:1039
#, python-format
msgid "%(name)s (folder, %(count)d tracks)"
msgstr "%(name)s (pasta, %(count)d faixas)"

#. Translators: Error returned by JukeboxManager.add_file() when the given path
#. does not exist; %s is the file path.
#: addon\globalPlugins\freeAudio\jukebox.py:1211
#, python-format
msgid "File not found: %s"
msgstr "Ficheiro não encontrado: %s"

#. Translators: Error returned by JukeboxManager.add_file() when the file's
#. extension isn't one of the supported audio formats; %s is the file path.
#: addon\globalPlugins\freeAudio\jukebox.py:1214
#, python-format
msgid "Not a recognized audio file: %s"
msgstr "Ficheiro de áudio não reconhecido: %s"

#. Translators: Error returned by JukeboxManager.add_file()/add_folder() when
#. that exact path is already saved in the jukebox library.
#. Translators: See the add_file() comment above: same message, returned by
#. add_folder() when the folder is already in the jukebox.
#: addon\globalPlugins\freeAudio\jukebox.py:1217
#: addon\globalPlugins\freeAudio\jukebox.py:1231
msgid "Already in the jukebox."
msgstr "Já está no jukebox."

#. Translators: Error returned by JukeboxManager.add_folder() when the given
#. folder path does not exist; %s is the folder path.
#: addon\globalPlugins\freeAudio\jukebox.py:1228
#, python-format
