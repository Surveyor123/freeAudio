#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1143
#, python-format
msgid "Copied: %s"
msgstr "Skopiowano: %s"

#. Translators: Spoken if the system clipboard can't be opened for the copy.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1146
msgid "Could not access clipboard"
msgstr "Nie udało się uzyskać dostępu do schowka"

