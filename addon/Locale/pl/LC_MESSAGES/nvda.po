#: addon\globalPlugins\freeAudio\__init__.py:1274
msgid "No audio book is playing"
msgstr "Żaden audiobook nie jest odtwarzany"

#. Translators: Spoken when downloading the currently playing audio book fails.
#: addon\globalPlugins\freeAudio\__init__.py:1281
msgid "Could not download this audio book."
msgstr "Nie udało się pobrać tego audiobooka."

#. Translators: Spoken once when a radio station (currently ABC Australia stations) is played through a special playback mode, because it would otherwise stutter.
#: addon\globalPlugins\freeAudio\__init__.py:1358
msgid "This station uses a special playback mode to prevent stuttering."
msgstr ""
"Ta stacja używa specjalnego trybu odtwarzania, aby zapobiec przerywaniu "
"dźwięku."

#. Translators: Spoken when a station's connection attempt fails outright, so the user isn't left thinking it's silently playing; %(name)s is the station name, %(reason)s is a short failure description.
#: addon\globalPlugins\freeAudio\__init__.py:1374
#, python-format
msgid "Could not play %(name)s: %(reason)s"
msgstr "Nie udało się odtworzyć %(name)s: %(reason)s"

#. Translators: Spoken during a manual update check when the GitHub repository has no published releases yet.
#: addon\globalPlugins\freeAudio\__init__.py:1598
