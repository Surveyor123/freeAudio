#. Translators: Error returned by resolve_media() when the book has no linked archive.org item id, so no audio files can be looked up.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:325
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:409
msgid "This book has no archive.org item to read audio files from."
msgstr ""
"Ta książka nie ma powiązanego elementu archive.org, z którego można odczytać "
"pliki audio."

#. Translators: Error returned by get_book_by_url() when the pasted URL doesn't match archive.org's book-details link pattern.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:342
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:432
#: addon\globalPlugins\freeAudio\librivox.py:426
msgid "This doesn't look like an archive.org book link."
msgstr "To nie wygląda na link do książki w archive.org."

#. Translators: Error returned when the archive.org identifier from a pasted link does not resolve to any item at all.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:360
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:451
#: addon\globalPlugins\freeAudio\librivox.py:445
msgid "Could not find a book at this address on archive.org."
msgstr "Nie znaleziono książki pod tym adresem w archive.org."

#. Translators: Error returned when a pasted archive.org link is not an audio item, or belongs to LibriVox or the Project Gutenberg collection, which have their own sources.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:368
msgid ""
"This archive.org item is not a general audio book (LibriVox and Project "
"Gutenberg titles have their own sources)."
msgstr ""

#. Translators: Error returned by the chapter-listing step when archive.org has no playable audio file for the resolved book.
#. Translators: Error returned by the archive.org metadata path when no playable audio file was found for the resolved book.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:427
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:522
#: addon\globalPlugins\freeAudio\librivox.py:506
msgid "No playable audio file was found for this book on archive.org."
msgstr ""
"Nie znaleziono pliku audio do odtworzenia dla tej książki w archive.org."

#. Translators: Raised internally when a chapter/book download completes but produced a zero-byte file; caught and shown to the user as a download failure.
#: addon\globalPlugins\freeAudio\archive_audiobooks.py:481
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:587
#: addon\globalPlugins\freeAudio\librivox.py:629
msgid "The downloaded file was empty."
msgstr "Pobrany plik był pusty."

