#: addon\globalPlugins\freeAudio\bookmarkUI.py:510
msgid "&Repeat Between Marked Bookmarks"
msgstr "Повторювати &між позначеними закладками"

#. Translators: Bookmark context-menu item; turns off the repeat mode.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:512
msgid "St&op Repeat"
msgstr "Зупинити &повтор"

#. Translators: Bookmark context-menu item; saves the section between the bookmarks marked with '.' as an audio file in the recordings folder, in a folder named after the media.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:515
