#. Translators: Checkbox label for the mute-notifications setting (same feature as the toggleMuteNotifications command).
#: addon\globalPlugins\freeAudio\settingsPanel.py:326
msgid "&Mute notifications (station changes, playback, recording)"
msgstr "&Вимкнути сповіщення (зміни станцій, відтворення, запис)"

#. Translators: Checkbox label for whether freeAudio notifications also show on a connected braille display.
#: addon\globalPlugins\freeAudio\settingsPanel.py:336
msgid "&Show freeAudio messages on the braille display"
msgstr "&Показувати повідомлення freeAudio на брайлівському дисплеї"

#. Translators: Label for the choice controlling what a single Ctrl+Win+P press does when nothing is currently playing.
#: addon\globalPlugins\freeAudio\settingsPanel.py:352
msgid "When Ctrl+Win+P is pressed with no active playback:"
msgstr "Коли натиснути Ctrl+Win+P без активного відтворення:"

#. Translators: The two choices for a single Ctrl+Win+P press with nothing playing: resume where playback left off, or open the favourites list to pick something.
#: addon\globalPlugins\freeAudio\settingsPanel.py:355
msgid "Resume last station"
