#: addon\globalPlugins\freeAudio\settingsPanel.py:371
#: addon\globalPlugins\freeAudio\settingsPanel.py:395
msgid "Open favourites list"
msgstr "Відкрити список улюблених"

#. Translators: Label for the choice controlling what a double Ctrl+Win+P press does.
#: addon\globalPlugins\freeAudio\settingsPanel.py:367
msgid "When Ctrl+Win+P is pressed twice:"
msgstr "Коли двічі натиснути Ctrl+Win+P:"

#. Translators: Choices for what a double/triple Ctrl+Win+P press can do - each opens a different freeAudio tab or performs a quick action; this same nine-item list is reused for both the double-press and triple-press settings (continues for the next eight lines).
#: addon\globalPlugins\freeAudio\settingsPanel.py:370
#: addon\globalPlugins\freeAudio\settingsPanel.py:394
msgid "Do nothing"
msgstr "Нічого не робити"

#: addon\globalPlugins\freeAudio\settingsPanel.py:372
#: addon\globalPlugins\freeAudio\settingsPanel.py:396
msgid "Open station search"
msgstr "Відкрити пошук станцій"

#: addon\globalPlugins\freeAudio\settingsPanel.py:373
#: addon\globalPlugins\freeAudio\settingsPanel.py:397
msgid "Open recording tab"
msgstr "Відкрити вкладку запису"

#: addon\globalPlugins\freeAudio\settingsPanel.py:374
#: addon\globalPlugins\freeAudio\settingsPanel.py:398
msgid "Open timer tab"
msgstr "Відкрити вкладку таймера"

#: addon\globalPlugins\freeAudio\settingsPanel.py:375
#: addon\globalPlugins\freeAudio\settingsPanel.py:399
msgid "Open liked songs tab"
msgstr "Відкрити вкладку «Вподобані треки»"

#: addon\globalPlugins\freeAudio\settingsPanel.py:376
#: addon\globalPlugins\freeAudio\settingsPanel.py:400
msgid "Open addon settings"
msgstr "Відкрити налаштування додатка"

#: addon\globalPlugins\freeAudio\settingsPanel.py:377
#: addon\globalPlugins\freeAudio\settingsPanel.py:401
msgid "Announce currently playing station"
msgstr "Оголосити станцію, яка зараз відтворюється"

#: addon\globalPlugins\freeAudio\settingsPanel.py:378
#: addon\globalPlugins\freeAudio\settingsPanel.py:402
msgid "Stop radio"
msgstr "Зупинити радіо"

#. Translators: Label for the choice controlling what a triple Ctrl+Win+P press does; same nine choices as the double-press setting above.
#: addon\globalPlugins\freeAudio\settingsPanel.py:392
msgid "When Ctrl+Win+P is pressed three times:"
msgstr "Коли тричі натиснути Ctrl+Win+P:"

#. --- Music Recognition ---
#. Translators: Section heading above the ffmpeg-path setting used by the music-recognition feature.
#: addon\globalPlugins\freeAudio\settingsPanel.py:417
msgid "Music Recognition via Shazam (Ctrl+Win+I × 3):"
msgstr "Розпізнавання треків через Shazam (Ctrl+Win+I × 3):"

#. Translators: Label for the ffmpeg.exe path text field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:419
msgid "ffmpeg.exe path (optional; auto-used from addon folder if empty):"
msgstr ""
"Шлях до файлу ffmpeg.exe (не обов'язково; якщо поле порожнє, "
"використовується автоматично шлях із папки додатка):"

#. Translators: Button label; opens a file-picker to choose ffmpeg.exe.
#: addon\globalPlugins\freeAudio\settingsPanel.py:428
msgid "Brows&e..."
msgstr "&Огляд..."

#. --- Recordings folder ---
#. Translators: Label for the custom recordings-folder path field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:436
msgid "Recordings folder:"
msgstr "Папка записів:"

#. Translators: Grey hint under the recordings-folder field explaining what happens if it's left empty.
#: addon\globalPlugins\freeAudio\settingsPanel.py:447
msgid "(empty = default: Documents\\freeAudio Recordings)"
msgstr "(порожньо = за замовчуванням: Documents\\freeAudio Recordings)"

#. Translators: Button label; opens a folder-picker to choose the recordings folder.
#: addon\globalPlugins\freeAudio\settingsPanel.py:451
msgid "Brow&se folder..."
msgstr "&Огляд папки..."

#. Translators: Label for the modules checklist (which optional tabs/features are shown at all).
#: addon\globalPlugins\freeAudio\settingsPanel.py:479
msgid "&Modules:"
msgstr "&Модулі:"

#. Translators: Checkbox label for whether the jukebox disk search also scans network drives (off by default - see the comment above about search time).
#: addon\globalPlugins\freeAudio\settingsPanel.py:499
msgid "Include &network drives when searching the jukebox"
msgstr "Включити &мережеві диски під час пошуку в черзі прослуховування"

#. Translators: Label for the audio-book-sources checklist (which catalogs to search/show).
#: addon\globalPlugins\freeAudio\settingsPanel.py:528
msgid "Audio book &sources:"
msgstr "&Джерела аудіокниг:"

#. --- GETEM audio books account ---
#. Credentials are not part of config.conf (which is stored as
#. plain text) - they're saved separately, encrypted with the
#. Windows Data Protection API; see getem.save_credentials().
#. Translators: Section heading above the GETEM username/password fields.
#: addon\globalPlugins\freeAudio\settingsPanel.py:545
msgid "GETEM Audio Books Account:"
msgstr "Обліковий запис аудіокниг GETEM:"

#. Translators: Label for the GETEM account username field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:548
msgid "GETEM username:"
msgstr "Ім'я користувача GETEM:"

#. Translators: Label for the GETEM account password field.
#: addon\globalPlugins\freeAudio\settingsPanel.py:556
msgid "GETEM password:"
msgstr "Пароль GETEM:"

#. Translators: Grey hint under the GETEM credential fields explaining how they are stored (see the comment above).
#: addon\globalPlugins\freeAudio\settingsPanel.py:565
msgid ""
"Stored encrypted on this computer, for this Windows user only. Leave both "
"fields empty and save to remove them."
msgstr ""
"Зберігається в зашифрованому вигляді на цьому комп'ютері, лише для цього "
"користувача Windows. Залиште обидва поля порожніми та збережіть зміни, щоб "
"видалити їх."

#. --- Recording output format ---
#. Translators: Label for the recording-output-format choice control.
#: addon\globalPlugins\freeAudio\settingsPanel.py:572
msgid "Recording output format:"
msgstr "Формат виводу запису:"

#. Translators: Choices for the recording output format: keep the original stream container as-is, keep the original audio codec but strip non-audio data, or convert to MP3 (continues for the next two lines).
#: addon\globalPlugins\freeAudio\settingsPanel.py:579
msgid "Original stream format (no conversion)"
msgstr "Оригінальний формат потоку (без конвертації)"

#: addon\globalPlugins\freeAudio\settingsPanel.py:580
msgid "Audio only, original codec (no quality loss)"
msgstr "Тільки аудіо, оригінальний кодек (без втрати якості)"

#: addon\globalPlugins\freeAudio\settingsPanel.py:581
msgid "MP3 (convert audio)"
msgstr "MP3 (конвертувати аудіо)"

#. Translators: Label for the MP3 bitrate choice, shown only when MP3 output is selected above.
#: addon\globalPlugins\freeAudio\settingsPanel.py:591
msgid "MP3 recording bitrate:"
msgstr "Бітрейт запису MP3:"

#. Translators: Checkbox label for skipping the pre-playback internet reachability check.
#: addon\globalPlugins\freeAudio\settingsPanel.py:608
msgid ""
"&Disable internet connectivity check before playing (recommended if DNS is "
"blocked)"
msgstr ""
"&Вимкнути перевірку підключення до Інтернету перед початком відтворення "
"(рекомендується, якщо DNS заблоковано)"

#. Translators: Checkbox label for the automatic update-check setting.
#: addon\globalPlugins\freeAudio\settingsPanel.py:619
msgid "&Automatically check for updates on startup"
msgstr "&Автоматично перевіряти наявність оновлень під час запуску"

#. Translators: Button label; triggers an immediate manual update check.
#. Translators: Restores the button's normal label once the manual update check finishes.
#: addon\globalPlugins\freeAudio\settingsPanel.py:627
#: addon\globalPlugins\freeAudio\settingsPanel.py:788
msgid "Check for Updates &Now"
msgstr "Перевірити наявність оновлень &зараз"

#. Translators: Button label; opens a dialog to reset freeAudio's settings and delete the data it has saved.
#: addon\globalPlugins\freeAudio\settingsPanel.py:632
msgid "&Clean up: reset settings and delete saved data..."
msgstr "&Очищення: скинути налаштування та видалити збережені дані..."

#. Translators: Title of the file-picker dialog for choosing ffmpeg.exe.
#: addon\globalPlugins\freeAudio\settingsPanel.py:764
msgid "Select ffmpeg.exe"
msgstr "Виберіть ffmpeg.exe"

#. Translators: Temporary label on the Check for Updates Now button while the check is in progress.
#: addon\globalPlugins\freeAudio\settingsPanel.py:775
msgid "Checking..."
msgstr "Перевірка..."

#. Use _notify so the message is suppressed when notifications are muted.
#. Translators: Spoken when a sleep timer fires and stops playback instantly (nothing was playing to fade out).
#. Use _notify so the stop message is suppressed when notifications are muted.
#. Translators: Spoken at the end of the fade-out, once volume has reached 0 and playback actually stops.
#: addon\globalPlugins\freeAudio\timerManager.py:219
#: addon\globalPlugins\freeAudio\timerManager.py:247
msgid "Sleep timer: radio stopped"
msgstr "Таймер сну: радіо зупинено"

#. Use _notify so both fade-out messages are suppressed when notifications are muted.
#. Translators: Spoken when a sleep timer fires while something is playing, before the 60-second volume fade-out begins.
#: addon\globalPlugins\freeAudio\timerManager.py:231
msgid "Sleep timer: fading out…"
msgstr "Таймер сну: поступове зменшення гучності…"

#. Translators: Spoken if seeking to the start of an audio-book part/jukebox track (the boundary clamp itself) fails.
#. No dedicated "Start of track" wording here - the elapsed/
#. remaining position _announce_seek_position() reports (0:00
#. elapsed) already makes that obvious on its own. Its
#. only-if-unavailable fallback reuses the same generic wording
#. the failure case above already uses.
#. Translators: Fallback spoken if _announce_seek_position() can't report a position after seeking to the start/end of an audio-book part or jukebox track.
#. Translators: Spoken if a plain (non-boundary) podcast/audiobook seek fails.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:187
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:195
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:217
msgid "Could not seek"
msgstr "Не вдалося виконати пошук позиції"

#. Translators: Fallback spoken only if _announce_seek_position() can't report a position; %d is the number of seconds seeked.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:221
#, python-format
msgid "Forwarded %d seconds"
msgstr "Переслано на %d секунд"

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:222
#, python-format
msgid "Rewound %d seconds"
msgstr "Перемотано назад на %d секунд"

#. Translators: Spoken when Ctrl+Win+J (rewind) is pressed while the time-shift feature itself is turned off in settings.
#. Translators: Same message as the rewind command, spoken here when Ctrl+Win+K (forward) is pressed with time-shift turned off.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:316
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:328
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:345
msgid "Time-shift buffer is disabled. Enable it in freeAudio settings."
msgstr "Буфер тайм-шифту вимкнено. Увімкніть його в налаштуваннях freeAudio."

#. Translators: One of the reasons a rewind/forward can fail, mapped from rewind_timeshift()'s return reason to a spoken message (continues for the next six lines: feature disabled, wrong backend, HLS unsupported, not enough buffer yet, buffer file not ready, engine error).
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:327
msgid ""
"Time-shift requires the BASS audio backend, which is currently disabled."
msgstr "Тайм-шифт потребує аудіодрайвер BASS, який наразі вимкнено."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:329
msgid "Time-shift is not available for the current playback backend."
msgstr "Тайм-шифт недоступний для поточного драйвера відтворення."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:330
msgid ""
"Time-shift is not supported for this station's stream (no seekable audio "
"could be extracted)."
msgstr ""
"Відкладення часу не підтримується для потокового передавання цієї станції "
"(не вдалося вилучити аудіо з можливістю пошуку)."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:331
msgid ""
"Not enough buffered audio to rewind yet. Wait a few seconds after the "
"station starts playing and try again."
msgstr ""
"У буфері недостатньо аудіо для перемотування. Зачекайте кілька секунд після "
"початку відтворення станції та повторіть спробу."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:332
msgid "Time-shift buffer file is not ready yet."
msgstr "Файл буфера тайм-шифту ще не готовий."

#: addon\globalPlugins\freeAudio\timeshiftMixin.py:333
msgid "Could not switch to time-shifted playback."
msgstr "Не вдалося переключитися на відтворення з тайм-шифтом."

#. Translators: Generic fallback spoken if the rewind fails for a reason not covered by the specific messages above.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:336
msgid "Could not rewind"
msgstr "Не вдалося перемотати назад"

#. Translators: Spoken after a successful rewind, reporting how far behind live the buffer now is; %.0f is the number of seconds.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:339
#, python-format
msgid "Rewound to %.0f seconds behind live"
msgstr "Перемотано на %.0f секунд позаду прямого ефіру"

#. Translators: Spoken when fast-forward is pressed but playback is already at the live edge (not time-shifted).
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:349
msgid "Already listening live"
msgstr "Ви вже слухаєте прямий ефір"

#. Translators: Generic fallback spoken if the fast-forward operation fails.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:355
msgid "Could not fast-forward"
msgstr "Не вдалося перемотати вперед"

#. Translators: Spoken when a fast-forward catches all the way up to the live edge.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:359
msgid "Back to live"
msgstr "Повернутися до прямого ефіру"

#. Translators: Spoken after a fast-forward that has not yet caught up to live; %.0f is how many seconds behind live remain.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:363
#, python-format
msgid "Fast-forwarded, still %.0f seconds behind live"
msgstr "Перемотано вперед, ще %.0f секунд позаду прямого ефіру"

#. Translators: Name of an NVDA command (Ctrl+Win+J); rewinds the live time-shift buffer, or seeks backward within a podcast/audiobook file if one is playing.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:368
msgid ""
"Time-shift: rewind 15 seconds (enters time-shift mode if not already active)"
msgstr ""
"Тайм-шифт: перемотати назад на 15 секунд (активує режим тайм-шифту, якщо він "
"ще не активний)"

#. Translators: Name of an NVDA command (Ctrl+Win+K); fast-forwards the live time-shift buffer (snapping to live once caught up), or seeks forward within a podcast/audiobook file if one is playing.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:384
msgid ""
"Time-shift: fast-forward 15 seconds, or return to live if already caught up"
msgstr ""
"Тайм-шифт: перемотати вперед на 15 секунд або повернутися до прямого ефіру, "
"якщо вже досягнуто"

#. Translators: Name of an NVDA command (Ctrl+Win+Alt+J); fine rewind by 1 second.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:400
msgid ""
"Fine rewind: 1 second (time-shift buffer, podcast, audiobook or jukebox)"
msgstr ""
"Точне перемотування назад: 1 секунда (буфер тайм-шифту, подкаст, аудіокнига "
"або черга прослуховування)"

#. Translators: Name of an NVDA command (Ctrl+Win+Alt+K); fine fast-forward by 1 second.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:412
msgid ""
"Fine forward: 1 second (time-shift buffer, podcast, audiobook or jukebox)"
msgstr ""
"Точне перемотування вперед: 1 секунда (буфер тайм-шифту, подкаст, аудіокнига "
"або черга прослуховування)"

#. Translators: Name of an NVDA command (Ctrl+Win+T); toggles the time-shift buffer feature on/off.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:424
msgid "Enable or disable the time-shift (rewind) buffer"
msgstr "Увімкнути або вимкнути буфер тайм-шифту (перемотування)"

#. Translators: Spoken after toggling the time-shift buffer; the 'enabled'/'disabled' word is the same one used throughout freeAudio's other toggle announcements.
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:449
#, python-format
msgid "Time-shift buffer %s"
msgstr "Буфер тайм-шифту %s"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:136
#, python-format
msgid "Recognition failed: %s"
msgstr "Помилка розпізнавання: %s"

#. Translators: Name of an NVDA command (Ctrl+Win+I); its behaviour escalates with repeated presses as the description itself explains.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:149
msgid ""
"Announce currently playing station. Press twice for full details, three "
"times to copy track info, four times to force music recognition."
msgstr ""
"Оголосити поточну станцію. Натисніть двічі для повної інформації, тричі — "
"щоб скопіювати інформацію про трек, чотири рази — щоб примусово розпізнати "
"трек."

#. Translators: First line of the What's Playing announcement when nothing is playing but one or more scheduled recordings are still running silently in the background; station names are appended after it, joined with two spaces.
#. Translators: Same as the Ctrl+Win+I version, spoken here by the F2 dialog equivalent.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:162
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:463
msgid "Radio inactive. Active scheduled recordings:"
msgstr "Радіо неактивне. Активні заплановані записи:"

#. Translators: Spoken by What's Playing when nothing is playing and no scheduled recording is active either.
#. Translators: Same "not active" message as What's Playing, spoken here when this standalone show-details gesture is used with nothing playing.
#. Translators: Same "not active" message as elsewhere, spoken here when this standalone copy/recognize gesture is used with nothing playing.
#. Translators: Same "not active" message as elsewhere, spoken here when this standalone force-recognition gesture is used with nothing playing.
#. Translators: Same "not active" message as elsewhere, spoken here by the F2 dialog equivalent of What's Playing.
#. Translators: Same "not active" message as elsewhere, spoken here when F8 (stop) is pressed with nothing playing and no recordings active.
#. Translators: Same "not active" message as elsewhere, spoken here by this hotkey-triggered station announcement.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:168
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:359
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:379
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:428
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:469
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:680
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:696
msgid "freeAudio is not active"
msgstr "freeAudio не активний"

#. Translators: Announcement spoken by Ctrl+Win+I (What's Playing) when the station provides an ICY track title; %(station)s is the station name, %(track)s the current track.
#. Translators: Same What's Playing announcement as script_whatsPlaying, spoken here by the F2 in-dialog variant (_whats_playing_from_dialog); %(station)s/%(track)s as above.
#. Translators: Same Playing announcement as script_whatsPlaying, spoken here by this hotkey-triggered variant.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:196
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:509
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:712
#, python-format
msgid "Playing: %(station)s — %(track)s"
msgstr "Відтворюється: %(station)s — %(track)s"

#. Translators: Same What's Playing announcement, used when no ICY track title is available - just the station name.
#. Translators: Same fallback as script_whatsPlaying, used when no ICY track title is available.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:201
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:514
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:717
#, python-format
msgid "Playing: %s"
msgstr "Відтворюється: %s"

#. Translators: Appended to the What's Playing announcement when an instant recording is currently active; %s is the station being recorded.
#. Translators: Same active-recording announcement as the playing-state case, appended here when paused.
#. Translators: Same active-recording announcement as script_whatsPlaying.
#. Translators: Same active-recording announcement as script_whatsPlaying's paused case.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:216
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:255
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:526
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:556
#, python-format
msgid "Recording: %s"
msgstr "Запис: %s"

#. Translators: What's Playing announcement when playback is paused rather than actively playing; %s is the station/track name.
#. Translators: Same Paused announcement as script_whatsPlaying, spoken here by the F2 dialog equivalent.
#. Translators: Same Paused announcement as elsewhere, spoken here by this hotkey-triggered variant.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:229
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:534
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:731
#, python-format
msgid "Paused: %s"
msgstr "Призупинено: %s"

#. Translators: Spoken by the triple-press action before kicking off Shazam recognition, since no ICY track title was available to just copy.
#. Translators: Same as the What's Playing triple-press case, spoken before starting Shazam recognition.
#. Translators: Same as the Ctrl+Win+I triple-press case, spoken here by the F2 dialog equivalent before starting Shazam recognition.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:321
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:410
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:609
msgid "No track metadata found. Starting music recognition…"
msgstr "Метадані трека не знайдені. Починається розпізнавання трека…"

#. Translators: Spoken when the fourth press starts forced Shazam recognition, regardless of whether ICY metadata exists.
#. Translators: Same as elsewhere, spoken when this standalone gesture starts forced Shazam recognition.
#. Translators: Same as the Ctrl+Win+I fourth-press case, spoken here by the F2 dialog equivalent.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:344
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:439
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:629
msgid "Starting music recognition…"
msgstr "Початок розпізнавання трека…"

#. Equivalent to pressing Control+Windows+I (or F2 in the dialog) twice.
#. Opens the station details dialog for the currently playing station.
#. Provided as an unbound gesture so users who have difficulty with
#. rapid key presses can assign a single keystroke to this action.
#. Translators: Name of an NVDA command; unbound-gesture equivalent of pressing Ctrl+Win+I (or F2 in the dialog) twice.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:353
msgid "Show details of the currently playing station"
msgstr "Показати інформацію про станцію, яка зараз відтворюється"

#. Equivalent to pressing Control+Windows+I (or F2 in the dialog) three times.
#. Copies the current ICY track title to the clipboard, or starts Shazam
#. music recognition when no metadata is available.
#. Provided as an unbound gesture so users who have difficulty with
#. rapid key presses can assign a single keystroke to this action.
#. Translators: Name of an NVDA command; unbound-gesture equivalent of pressing Ctrl+Win+I (or F2 in the dialog) three times.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:372
msgid ""
"Copy current track info to clipboard, or start music recognition if "
"unavailable"
msgstr ""
"Скопіювати інформацію про поточний трек у буфер обміну або запустити "
"розпізнавання музики, якщо ця функція недоступна"

#. Equivalent to pressing Control+Windows+I (or F2 in the dialog) four times.
#. Forces Shazam music recognition regardless of whether ICY metadata is present.
#. Provided as an unbound gesture so users who have difficulty with
#. rapid key presses can assign a single keystroke to this action.
#. Translators: Name of an NVDA command; unbound-gesture equivalent of pressing Ctrl+Win+I (or F2 in the dialog) four times.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:421
msgid "Force music recognition for the currently playing stream"
msgstr "Примусове розпізнавання музики для поточного потоку"

#. Translators: Field-name row header for the parent podcast feed's URL.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:865
msgid "Podcast"
msgstr "Подкаст"

#. Translators: Field-name row header for the resolved episode audio URL.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:881
msgid "Episode URL"
msgstr "URL епізоду"

#. Translators: Field-name row header for a local jukebox file; value is the track title/filename.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:899
msgid "Track"
msgstr "Трек"

#. Translators: Field-name row header for the track's full file path.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:904
msgid "File"
msgstr "Файл"

#. Translators: Field-name row header for the track's file size.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:909
msgid "Size"
msgstr "Розмір"

#. Translators: Field-name row header for the track's duration.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:914
msgid "Duration"
msgstr "Тривалість"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:924
#, python-format
msgid "%d kbps"
msgstr "%d кбіт/с"

#. Translators: Field-name row header for the track's sample rate; value has its own %.1f-based unit string.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:929
msgid "Sample rate"
msgstr "Частота дискретизації"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:929
#, python-format
msgid "%.1f kHz"
msgstr "%.1f кГц"

#. Translators: shown as a jukebox track's channel count in the details dialog
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:934
msgid "Mono"
msgstr "Моно"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:934
msgid "Stereo"
msgstr "Стерео"

#. Translators: Field-name row header for the track's channel count (mono/stereo/etc.).
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:936
msgid "Channels"
msgstr "Канали"

#. Translators: Field-name row header for the track's bit depth; value has its own %d-based unit string.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:941
msgid "Bit depth"
msgstr "Розрядність"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:941
#, python-format
msgid "%d-bit"
