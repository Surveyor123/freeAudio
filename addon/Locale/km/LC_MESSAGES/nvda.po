#: addon\globalPlugins\freeAudio\radioDialog.py:6963
msgid "Re&move Feed"
msgstr "លុបហ្វីត(&M)"

#. Translators: Context menu item - saves an audio profile (volume/effects/speed) that applies to every episode of this podcast
#: addon\globalPlugins\freeAudio\radioDialog.py:6969
#: addon\globalPlugins\freeAudio\radioDialog.py:7085
msgid "Save Audio Pr&ofile for This Podcast"
msgstr "រក្សាទុកទម្រង់សំឡេងសម្រាប់ផតខាស់នេះ &o"

#. Translators: Context-menu item; copies the feed's URL to the clipboard.
#: addon\globalPlugins\freeAudio\radioDialog.py:6980
msgid "&Copy Feed URL"
msgstr "ចម្លង URL ហ្វីត(&C)"

#. Translators: Spoken when trying to play the previous jukebox track while already on the first one.
#: addon\globalPlugins\freeAudio\radioDialog.py:6991
msgid "Already at first track"
msgstr "បទទីមួយរួចហើយ"

#. Translators: Spoken when trying to play the next jukebox track while already on the last one.
#: addon\globalPlugins\freeAudio\radioDialog.py:7009
msgid "Already at last track"
msgstr "បទចុងក្រោយរួចហើយ"

#. Translators: Spoken when cycling to the previous jukebox library entry while already on the first one.
#: addon\globalPlugins\freeAudio\radioDialog.py:7020
msgid "Already at first item"
msgstr "ធាតុទីមួយរួចហើយ"

#. Translators: Spoken when cycling to the next jukebox library entry while already on the last one.
#: addon\globalPlugins\freeAudio\radioDialog.py:7045
msgid "Already at last item"
msgstr "ធាតុចុងក្រោយរួចហើយ"

#. Translators: Context-menu item; plays the selected episode.
#: addon\globalPlugins\freeAudio\radioDialog.py:7068
msgid "&Play Episode"
msgstr "ចាក់ភាគ(&P)"

#. Translators: Context-menu item; copies the episode's direct audio URL to the clipboard.
#: addon\globalPlugins\freeAudio\radioDialog.py:7096
msgid "&Copy Episode URL"
msgstr "ចម្លង URL ភាគ(&C)"

#. Translators: Spoken after any "Copy ..." context-menu action succeeds (URL, path, etc.) - a single generic confirmation shared by all of them.
#: addon\globalPlugins\freeAudio\radioDialog.py:7111
msgid "Copied to clipboard"
msgstr "បានចម្លងទៅក្ដារតម្បៀតខ្ទាស់"

#. Translators: Source-name label for a book from the Project Gutenberg Open Audiobook Collection.
#: addon\globalPlugins\freeAudio\radioDialog.py:7168
#: addon\globalPlugins\freeAudio\settingsPanel.py:523
msgid "Project Gutenberg"
msgstr "គម្រោង Gutenberg"

#. Translators: Accessible name of the audio book search field - searches both GETEM and LibriVox at once
#: addon\globalPlugins\freeAudio\radioDialog.py:7187
msgid ""
"Search audio books by title, author, narrator, subject, or publisher. Press "
"enter to search"
