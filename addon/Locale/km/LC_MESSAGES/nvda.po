#, python-format
msgid "Do you want to remove the %d marked book from the library?"
msgid_plural "Do you want to remove the %d marked books from the library?"
msgstr[0] "តើអ្នកចង់ដកចេញសៀវភៅ %d ដែលបានជ្រើសរើសពីបណ្ណាល័យមែនទេ?"

#. Translators: Title of the bulk-remove confirmation dialog for audio books.
#: addon\globalPlugins\freeAudio\radioDialog.py:7773
msgid "Remove From Library"
msgstr "ដកចេញពីបណ្ណាល័យ &R"

#. Translators: Spoken after bulk-removing marked audio books from the library; %d is how many were removed.
#: addon\globalPlugins\freeAudio\radioDialog.py:7790
#, python-format
msgid "%d book removed"
msgid_plural "%d books removed"
msgstr[0] "សៀវភៅ %d ត្រូវបានដកចេញរួចរាល់ហើយ"

#. Translators: Spoken while resolving a book's chapter list before playing it for the first time; %s is the book title.
#. Translators: Spoken when starting a specific GETEM chapter/part; %s is the chapter title.
#. Translators: Same message as _play_getem_book, spoken here while resolving a book's chapter list before downloading it.
#: addon\globalPlugins\freeAudio\radioDialog.py:7824
#: addon\globalPlugins\freeAudio\radioDialog.py:7879
#: addon\globalPlugins\freeAudio\radioDialog.py:8274
#, python-format
msgid "Loading: %s"
msgstr "កំពុងផ្ទុក៖ %s"

#. Translators: Spoken when F3 (previous book) is pressed with no books in the audio-book library.
#. Translators: Spoken when F4 (next book) is pressed with no books in the audio-book library.
#: addon\globalPlugins\freeAudio\radioDialog.py:7946
#: addon\globalPlugins\freeAudio\radioDialog.py:7968
msgid "Library is empty"
msgstr "បណ្ណាល័យទទេ"

#. Translators: Spoken when F3 (previous book) is pressed while already on the first book.
#: addon\globalPlugins\freeAudio\radioDialog.py:7951
msgid "Already at first book"
msgstr "សៀវភៅទីមួយរួចហើយ"

#. Translators: Spoken when F4 (next book) is pressed while already on the last book.
#: addon\globalPlugins\freeAudio\radioDialog.py:7973
msgid "Already at last book"
msgstr "សៀវភៅចុងក្រោយរួចហើយ"

