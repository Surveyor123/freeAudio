#. Translators: Spoken after clearing a book's saved audio profile; %(book)s is the book title.
#: addon\globalPlugins\freeAudio\radioDialog.py:8197
#, python-format
msgid "Audio profile cleared for %(book)s"
msgstr "ទម្រង់សំឡេងត្រូវបានសម្អាតសម្រាប់ %(book)s"

#. Translators: Spoken after removing a book from the audio-book library; %s is the book title.
#: addon\globalPlugins\freeAudio\radioDialog.py:8227
#, python-format
msgid "Removed from library: %s"
