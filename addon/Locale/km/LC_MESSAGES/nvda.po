msgid "&Stop Preview"
msgstr "បញ្ឈប់ការមើលជាមុន(&S)"

#: addon\globalPlugins\freeAudio\radioDialog.py:6818
#: addon\globalPlugins\freeAudio\radioDialog.py:7616
#: addon\globalPlugins\freeAudio\radioDialog.py:8627
msgid "&Preview"
msgstr "មើលជាមុន(&P)"

