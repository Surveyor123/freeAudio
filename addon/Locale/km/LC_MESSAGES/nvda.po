#. Translators: Placeholder row shown in the results list when a device search finds nothing.
#. Translators: Spoken alongside the placeholder row above.
#: addon\globalPlugins\freeAudio\radioDialog.py:8558
#: addon\globalPlugins\freeAudio\radioDialog.py:8560
msgid "No matching audio files found."
msgstr "រកមិនឃើញឯកសារសំឡេងដែលត្រូវគ្នាទេ។"

#. Translators: Plural forms spoken after a successful device search; %d is how many audio files were found.
#: addon\globalPlugins\freeAudio\radioDialog.py:8566
#, python-format
msgid "%d file found."
msgid_plural "%d files found."
msgstr[0] "រកឃើញ %d ឯកសារ។"

#. Translators: Same confirmation as adding a folder; spoken here after adding a single audio file from a device-search result.
#. Translators: Same confirmation as adding a single file; spoken here after adding a single folder to the jukebox.
#. Translators: Spoken after successfully adding an Explorer file or folder to the jukebox; %s is its display title.
#: addon\globalPlugins\freeAudio\radioDialog.py:8616
#: addon\globalPlugins\freeAudio\radioDialog.py:9123
#: addon\appModules\explorer.py:213
#, python-format
