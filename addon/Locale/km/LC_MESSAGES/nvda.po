#: addon\globalPlugins\freeAudio\trackInfoMixin.py:900
msgid "Sample rate"
msgstr "អត្រាគំរូ"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:900
#, python-format
msgid "%.1f kHz"
msgstr "%.1f kHz"

#. Translators: shown as a jukebox track's channel count in the details dialog
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:905
msgid "Mono"
msgstr "ម៉ូណូ"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:905
msgid "Stereo"
msgstr "ស្តេរ៉េអូ"

#. Translators: Field-name row header for the track's channel count (mono/stereo/etc.).
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:907
msgid "Channels"
msgstr "ឆានែល"

#. Translators: Field-name row header for the track's bit depth; value has its own %d-based unit string.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:912
msgid "Bit depth"
msgstr "ជម្រៅប៊ីត"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:912
#, python-format
msgid "%d-bit"
msgstr "%d-bit"

#. Translators: Field-name row header in this dialog's audio-book details table; value is the book title.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:938
msgid "Book"
msgstr "សៀវភៅ"

#. Translators: Field-name row header for the current chapter/part when both its position and the total count are known; value is "Title (n/total)".
#. Translators: Same field-name row header as above, used when the chapter position/total count is not known - just the chapter title.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:947
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:952
msgid "Chapter"
msgstr "ជំពូក"

#. Translators: Field-name row header for the book's GETEM detail-page URL.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:979
msgid "Book link"
msgstr "តំណភ្ជាប់សៀវភៅ"

#. Translators: Spoken after the triple-press/F2/gesture actions copy the current ICY track title to the clipboard; %s is the copied text.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1143
#, python-format
msgid "Copied: %s"
msgstr "បានចម្លង: %s"

#. Translators: Spoken if the system clipboard can't be opened for the copy.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1146
msgid "Could not access clipboard"
msgstr "មិនអាចចូលប្រើ clipboard បានទេ"

#. Translators: Spoken instead of saving a duplicate when the copied track is already in likedSongs.txt; %s is the track text.
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1164
#, python-format
msgid "Already in liked songs: %s"
msgstr "មាននៅក្នុងបទចម្រៀងដែលចូលចិត្តរួចហើយ: %s"

#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1193
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1220
#, python-format
msgid "Song recording saved: %s"
msgstr "ការ​ថត​ចម្រៀង​ត្រូវ​បាន​រក្សា​ទុក: %s"

#. Translators: Spoken automatically while a live recording is in progress if the time-shift disk-space limit is reached and old buffered audio is being discarded faster than usual.
#: addon\globalPlugins\freeAudio\__init__.py:498
msgid ""
"Time-shift buffer: running low on disk space, the oldest audio is being "
"dropped more aggressively."
msgstr ""
"តំបន់ផ្ទុកបណ្ដោះអាសន្នសម្រាប់ប្ដូរពេលវេលា៖ ទំហំថាសជិតអស់ហើយ "
"សំឡេងចាស់ជាងគេកំពុងត្រូវបានលុបចេញយ៉ាងខ្លាំងក្លា។"

#. Translators: Spoken when a recording finishes normally; %s is the saved output filename.
#: addon\globalPlugins\freeAudio\__init__.py:588
#, python-format
msgid "Recording finished: %s"
msgstr "ដំណើរការថតបានបញ្ចប់ហើយ: %s"

#. Translators: Spoken when a recording never actually started because the stream connection failed for its whole scheduled window; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:593
#, python-format
msgid "Recording failed: could not connect to %s"
msgstr "ការថតបានបរាជ័យ៖ មិនអាចភ្ជាប់ទៅ %s បានទេ"

#. Translators: Spoken when converting a finished recording to the configured format (e.g. MP3) fails; the original, unconverted file is kept. %s is its filename.
#: addon\globalPlugins\freeAudio\__init__.py:598
#, python-format
msgid "Recording conversion failed. The original file was kept: %s"
msgstr "ការបំប្លែងការថតបានបរាជ័យ។ ឯកសារដើមត្រូវបានរក្សាទុក៖ %s"

#. Translators: Spoken when the folder configured for recordings can't be used (e.g. missing/no permission) and freeAudio saved to its default folder instead; %(station)s is the station name, %(reason)s is why the folder failed.
#: addon\globalPlugins\freeAudio\__init__.py:604
#, python-format
msgid ""
"Could not use the selected folder for '%(station)s' (%(reason)s). Saved to "
"the default recordings folder instead."
msgstr ""
"មិនអាចប្រើថតដែលបានជ្រើសរើសសម្រាប់ '%(station)s' (%(reason)s) បានទេ។ "
"បានរក្សាទុកទៅក្នុងថតលំនាំដើមវិញ។"

#. ── 2. Create / refresh a script for every favourite ─────────────────
#. Translators: Script category shown in NVDA's Input Gestures dialog, grouping the auto-generated 'play this favourite station' shortcuts separately from freeAudio's main commands.
#: addon\globalPlugins\freeAudio\__init__.py:696
msgid "freeAudio Stations"
msgstr "ស្ថានីយ៍ freeAudio"

#. Translators: Spoken if a per-favourite-station shortcut is triggered after that station was removed from favourites since the shortcut was created; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:717
#, python-format
msgid "Station no longer in favourites: %s"
msgstr "ស្ថានីយ៍លែងនៅក្នុងបញ្ជីចូលចិត្តទៀតហើយ: %s"

#. NVDA reads __doc__ as the script description and
#. __name__ as the script identifier.
#. Translators: Auto-generated description of a per-favourite-station shortcut, shown in NVDA's Input Gestures dialog; %s is the station name.
#. NVDA reads __doc__ as the script description and
#. __name__ as the script identifier.
#. Translators: Auto-generated description of a per-jukebox-entry shortcut, shown in NVDA's Input Gestures dialog; %s is the entry's display title.
#: addon\globalPlugins\freeAudio\__init__.py:727
#: addon\globalPlugins\freeAudio\__init__.py:807
#, python-format
msgid "%s playback shortcut"
msgstr "ផ្លូវកាត់សម្រាប់ចាក់ %s"

#. ── 2. Create / refresh a script for every entry ─────────────────────
#. Translators: Script category shown in NVDA's Input Gestures dialog, grouping the auto-generated 'play this jukebox entry' shortcuts separately from freeAudio's main commands.
#: addon\globalPlugins\freeAudio\__init__.py:779
#, fuzzy
msgid "freeAudio Jukebox"
msgstr "បើក jukebox មូលដ្ឋានរបស់ freeAudio"

#. Translators: Spoken if a per-jukebox-entry shortcut is triggered after that entry was removed from the jukebox since the shortcut was created; %s is the entry's display title.
#: addon\globalPlugins\freeAudio\__init__.py:800
#, fuzzy, python-format
msgid "Entry no longer in the jukebox: %s"
msgstr "ស្ថានីយ៍លែងនៅក្នុងបញ្ជីចូលចិត្តទៀតហើយ: %s"

#. Translators: Menu item that opens the freeAudio station browser dialog
#: addon\globalPlugins\freeAudio\__init__.py:883
msgid "Station &Browser...\tCtrl+Win+R"
msgstr "កម្មវិធីរុករកស្ថានីយ៍ &B...\tCtrl+Win+R"

#. Translators: Menu item that opens freeAudio settings in NVDA preferences
#: addon\globalPlugins\freeAudio\__init__.py:892
msgid "freeAudio &Settings..."
msgstr "ការកំណត់ &freeAudio..."

#. Translators: Menu item that manually triggers the update check
#: addon\globalPlugins\freeAudio\__init__.py:901
msgid "Check for &Updates..."
msgstr "ពិនិត្យរកមើល &ការធ្វើបច្ចុប្បន្នភាព..."

#. Translators: Label of the freeAudio submenu in NVDA Tools menu
#: addon\globalPlugins\freeAudio\__init__.py:914
msgid "&freeAudio"
msgstr "&freeAudio"

#. Translators: Name of an NVDA command; opens the freeAudio station browser dialog on its main Stations tab.
#: addon\globalPlugins\freeAudio\__init__.py:975
msgid "Open freeAudio station browser"
msgstr "បើកកម្មវិធីរុករកស្ថានីយ៍វិទ្យុរបស់ freeAudio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the Audio Books tab.
#: addon\globalPlugins\freeAudio\__init__.py:985
msgid "Open freeAudio audio book library"
msgstr "បើកបណ្ណាល័យសៀវភៅជាសំឡេង freeAudio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the Podcasts tab.
#: addon\globalPlugins\freeAudio\__init__.py:995
msgid "Open freeAudio podcast subscriptions"
msgstr "បើកការជាវផតខាស់ freeAudio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the local Jukebox tab.
#: addon\globalPlugins\freeAudio\__init__.py:1005
msgid "Open freeAudio local jukebox"
msgstr "បើក jukebox មូលដ្ឋានរបស់ freeAudio"

#. Translators: Name of an NVDA command whose behaviour depends on what is currently playing: adds a live station to favourites, or downloads the current audio book/podcast episode.
#: addon\globalPlugins\freeAudio\__init__.py:1015
msgid ""
"Add currently playing station to favourites, download the whole audio book "
"if one is playing, or download the episode if a podcast is playing"
msgstr ""
"បន្ថែមស្ថានីយ៍ដែលកំពុងចាក់ទៅក្នុងបញ្ជីចំណូលចិត្ត ទាញយកសៀវភៅជាសំឡេងទាំងមូលប្រសិនបើមានកំពុងចាក់ "
"ឬទាញយកភាគប្រសិនបើមានផតខាស់កំពុងចាក់"

#. Translators: Spoken when this shortcut is pressed while something is playing that is neither a station, podcast episode, nor audio book (e.g. a local jukebox track).
#: addon\globalPlugins\freeAudio\__init__.py:1035
msgid "The shortcut is only for stations, podcasts or audio books"
msgstr "ផ្លូវកាត់នេះសម្រាប់តែស្ថានីយ៍វិទ្យុ ផតខាស់ ឬសៀវភៅជាសំឡេងប៉ុណ្ណោះ"

#. Translators: Spoken when the currently playing station is already saved in favourites; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:1057
#, python-format
msgid "Already in favourites: %s"
msgstr "មាននៅក្នុងចំណូលចិត្តរួចហើយ: %s"

#. Translators: Spoken after successfully adding the currently playing station to favourites; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:1061
#, python-format
msgid "Added to favourites: %s"
msgstr "បានបន្ថែមទៅក្នុងចំណូលចិត្តរួចហើយ: %s"

#. Translators: Spoken when this shortcut is pressed to download an audio book but no audio book (GETEM/Gutenberg/LibriVox) is currently playing.
#: addon\globalPlugins\freeAudio\__init__.py:1076
msgid "No audio book is playing"
msgstr "មិនមានសៀវភៅជាសំឡេងណាមួយកំពុងចាក់ទេ"

#. Translators: Spoken when downloading the currently playing audio book fails.
#: addon\globalPlugins\freeAudio\__init__.py:1083
msgid "Could not download this audio book."
msgstr "មិនអាចទាញយកសៀវភៅជាសំឡេងនេះបានទេ។"

#. Translators: Spoken when a station's connection attempt fails outright, so the user isn't left thinking it's silently playing; %(name)s is the station name, %(reason)s is a short failure description.
#: addon\globalPlugins\freeAudio\__init__.py:1166
#, python-format
msgid "Could not play %(name)s: %(reason)s"
msgstr "មិនអាចចាក់ %(name)s បានទេ៖ %(reason)s"

#. Translators: Spoken during a manual update check when the GitHub repository has no published releases yet.
#: addon\globalPlugins\freeAudio\__init__.py:1375
msgid "No releases found on GitHub yet."
msgstr "មិនទាន់រកឃើញការចេញផ្សាយនៅលើ GitHub នៅឡើយទេ។"

#. Translators: Spoken during a manual update check when the GitHub API request itself returns an HTTP error; %d is the HTTP status code.
#: addon\globalPlugins\freeAudio\__init__.py:1380
#, python-format
msgid "Update check failed (HTTP %d)."
msgstr "ការត្រួតពិនិត្យការធ្វើបច្ចុប្បន្នភាពបានបរាជ័យ (HTTP %d)."

#. Translators: Spoken during a manual update check when the request to GitHub fails outright (e.g. no internet connection).
#: addon\globalPlugins\freeAudio\__init__.py:1386
msgid "Update check failed. Please check your internet connection."
msgstr "ការត្រួតពិនិត្យការធ្វើបច្ចុប្បន្នភាពបានបរាជ័យ។ សូមពិនិត្យមើលការតភ្ជាប់អ៊ីនធឺណិតរបស់អ្នក។"

#. Translators: Spoken during a manual update check when GitHub's release data doesn't include a usable version tag.
#: addon\globalPlugins\freeAudio\__init__.py:1402
msgid "Could not determine latest version."
msgstr "មិនអាចកំណត់កំណែចុងក្រោយបំផុតបានទេ។"

#. Translators: Update dialog message when direct install is available. %(new)s=new version, %(current)s=current version
#: addon\globalPlugins\freeAudio\__init__.py:1421
#, python-format
msgid ""
"A new version of freeAudio is available: %(new)s.\n"
"You have version %(current)s.\n"
"\n"
"Would you like to download and install it now?"
msgstr ""
"កំណែថ្មីនៃ freeAudio មានសម្រាប់ប្រើបានហើយ: %(new)s.\n"
"អ្នកមានកំណែ %(current)s.\n"
"\n"
"តើអ្នកចង់ទាញយក និងដំឡើងវាឥឡូវនេះទេ?"

#: addon\globalPlugins\freeAudio\__init__.py:1424
#: addon\globalPlugins\freeAudio\__init__.py:1433
#: addon\globalPlugins\freeAudio\__init__.py:1501
msgid "unknown"
msgstr "មិនស្គាល់"

#. Translators: Button label on the update-available dialog when a direct .nvda-addon download is available, offering to install it right away.
#: addon\globalPlugins\freeAudio\__init__.py:1426
msgid "&Install"
msgstr "ដំឡើង &I"

#. Translators: Update dialog message when only a download page is available. %(new)s=new version, %(current)s=current version
#: addon\globalPlugins\freeAudio\__init__.py:1430
#, python-format
msgid ""
"A new version of freeAudio is available: %(new)s.\n"
"You have version %(current)s.\n"
"\n"
"Would you like to open the download page?"
msgstr ""
"កំណែថ្មីនៃ freeAudio មានសម្រាប់ប្រើបានហើយ: %(new)s.\n"
"អ្នកមានកំណែ %(current)s.\n"
"\n"
"តើអ្នកចង់បើកទំព័រទាញយកទេ?"

#. Translators: Button label on the update-available dialog when only a release web page (no direct download) is available, offering to open it in a browser.
#: addon\globalPlugins\freeAudio\__init__.py:1435
msgid "&Open Page"
msgstr "បើកទំព័រ &O"

#. Translators: Title of the dialog shown when a newer freeAudio version is available.
#: addon\globalPlugins\freeAudio\__init__.py:1441
msgid "freeAudio Update Available"
msgstr "មានការធ្វើបច្ចុប្បន្នភាព freeAudio ហើយ"

#. Translators: 'Cancel' button label on the update-available dialog, paired with whichever install/open-page label is used as the other button.
#: addon\globalPlugins\freeAudio\__init__.py:1445
msgid "&Cancel"
msgstr "បោះបង់ &C"

#. Translators: Spoken while the new version is being downloaded for direct install; %s is the version number being downloaded.
#: addon\globalPlugins\freeAudio\__init__.py:1461
#, python-format
msgid "Downloading freeAudio %s…"
msgstr "កំពុងទាញយក freeAudio %s…"

#. Translators: Spoken when the downloaded .nvda-addon file can't be handed to NVDA's installer automatically; %s is the path where the file was saved so the user can open it manually.
#: addon\globalPlugins\freeAudio\__init__.py:1491
#, python-format
msgid "Could not launch installer. File saved to: %s"
msgstr "មិនអាចបើកកម្មវិធីដំឡើងបានទេ។ ឯកសារត្រូវបានរក្សាទុកទៅក្នុង: %s"

#. Translators: Message and title of the dialog shown after a manual update check finds no newer version; %s is the currently installed version, or the fallback 'unknown' label just below if it could not be determined.
#: addon\globalPlugins\freeAudio\__init__.py:1501
#, python-format
msgid "freeAudio is up to date. Installed: %s"
msgstr "freeAudio គឺទាន់សម័យហើយ។ បានដំឡើងរួចរាល់ហើយ: %s"

#: addon\globalPlugins\freeAudio\__init__.py:1502
msgid "freeAudio Update Check"
msgstr "ពិនិត្យមើលការធ្វើបច្ចុប្បន្នភាពរបស់ freeAudio"

#. Translators: Name of an NVDA command; plays the audio file focused in Windows Explorer with freeAudio, without needing it to already be in the jukebox library.
#: addon\appModules\explorer.py:227
msgid "Play the focused file with freeAudio"
msgstr "ចាក់ឯកសារដែលកំពុងផ្តោតដោយ freeAudio"

#. Deliberately out of scope - see explorerIntegrationMixin.py's
#. matching comment (same reasoning: folder auto-advance needs
#. the folder to already be a persisted JukeboxManager entry).
#. Translators: Spoken when the "play focused item" Explorer shortcut is used on a folder rather than a file.
#: addon\appModules\explorer.py:242
msgid ""
"This is a folder. Playing only works for files - add it to the jukebox to "
"play the whole folder."
msgstr ""
"នេះគឺជាថត។ ការចាក់ដំណើរការបានសម្រាប់តែឯកសារប៉ុណ្ណោះ - សូមបន្ថែមវាទៅ jukebox "
"ដើម្បីចាក់ថតទាំងមូល។"

#. Translators: Spoken when the "play focused item" Explorer shortcut is used on a file that isn't a recognized audio format.
#: addon\appModules\explorer.py:246
msgid "Not a recognized audio file."
msgstr "មិនមែនជាឯកសារសំឡេងដែលស្គាល់ទេ។"

#. Translators: Name of an NVDA command; adds the file or folder focused in Windows Explorer to the freeAudio jukebox.
#: addon\appModules\explorer.py:260
msgid "Add the focused item to the freeAudio jukebox"
msgstr "បន្ថែមធាតុដែលកំពុងផ្តោតទៅ jukebox របស់ freeAudio"

# | msgid "FreeRadio - Station Browser"
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
