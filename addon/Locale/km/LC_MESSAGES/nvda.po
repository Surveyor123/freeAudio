#: addon\globalPlugins\freeAudio\radioDialog.py:6918
msgid "Already at last feed"
msgstr "ហ្វីតចុងក្រោយរួចហើយ"

#. Translators: Context-menu item; subscribes to the selected podcast search result.
#: addon\globalPlugins\freeAudio\radioDialog.py:6940
msgid "&Subscribe"
msgstr "ជាវ(&S)"

#. Translators: Context-menu item; re-fetches the selected feed for new episodes right now.
#: addon\globalPlugins\freeAudio\radioDialog.py:6959
msgid "&Refresh Feed"
msgstr "ធ្វើបច្ចុប្បន្នភាពហ្វីត(&R)"

