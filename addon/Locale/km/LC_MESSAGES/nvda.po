#. Translators: Spoken when a jukebox entry's Input Gestures shortcut is triggered but the entry has no usable audio files.
#: addon\globalPlugins\freeAudio\radioDialog.py:8867
#: addon\globalPlugins\freeAudio\__init__.py:851
msgid "No playable audio in this item."
msgstr "គ្មានសំឡេងដែលអាចចាក់បាននៅក្នុងធាតុនេះទេ។"

#: addon\globalPlugins\freeAudio\radioDialog.py:8948
#, python-format
msgid "Do you want to remove the %d marked entry from the jukebox?"
msgid_plural "Do you want to remove the %d marked entries from the jukebox?"
msgstr[0] "តើអ្នកចង់ដកចេញធាតុ %d ដែលបានជ្រើសរើសពីម៉ាស៊ីនចាក់ចម្រៀងមែនទេ?"

#. Translators: Title of the bulk-remove confirmation dialog for jukebox entries.
#. Translators: Title of the jukebox remove-confirmation dialog.
#: addon\globalPlugins\freeAudio\radioDialog.py:8953
#: addon\globalPlugins\freeAudio\radioDialog.py:9140
msgid "Remove From Jukebox"
msgstr "ដកចេញពី Jukebox"

#. Translators: Spoken after bulk-removing marked jukebox entries; %d is how many were removed.
#: addon\globalPlugins\freeAudio\radioDialog.py:8965
#, python-format
msgid "%d entry removed"
msgid_plural "%d entries removed"
msgstr[0] "ធាតុ %d ត្រូវបានដកចេញរួចរាល់ហើយ"

#. Translators: Context-menu item; plays the selected track from within a jukebox folder entry.
#. Translators: Context-menu item; plays the selected jukebox file/folder.
#: addon\globalPlugins\freeAudio\radioDialog.py:9010
#: addon\globalPlugins\freeAudio\radioDialog.py:9255
msgid "&Play"
msgstr "ចាក់ &P"

#. Translators: Jukebox track context menu item - saves an audio profile (volume/effects/speed/transpose) that applies to this file
#. Translators: Jukebox context menu item - saves an audio profile (volume/effects/speed/transpose) that applies to this file
#: addon\globalPlugins\freeAudio\radioDialog.py:9016
#: addon\globalPlugins\freeAudio\radioDialog.py:9286
msgid "Save Audio Pr&ofile for This File"
msgstr "រក្សាទុកទម្រង់សំឡេងសម្រាប់ឯកសារនេះ &o"

#. Translators: Context-menu item; copies the selected track's file path to the clipboard.
#. Translators: Context-menu item; copies the selected entry's file/folder path to the clipboard.
#: addon\globalPlugins\freeAudio\radioDialog.py:9026
#: addon\globalPlugins\freeAudio\radioDialog.py:9297
msgid "&Copy Path"
msgstr "ចម្លងផ្លូវ &C"

#. Translators: File-type filter label for the add-audio-files picker; %s is a glob pattern of supported extensions (e.g. '*.mp3;*.ogg'), also appended raw after the '|' as required by the file-dialog format - don't translate the pattern itself.
#: addon\globalPlugins\freeAudio\radioDialog.py:9035
#, python-format
msgid "Audio files (%s)"
msgstr "ឯកសារសំឡេង (%s)"

#. Translators: Title of the file-picker dialog for adding files to the jukebox.
#: addon\globalPlugins\freeAudio\radioDialog.py:9039
msgid "Add audio files to the jukebox"
msgstr "បន្ថែមឯកសារសំឡេងទៅ jukebox"

#. Translators: Plural forms spoken after adding files to the jukebox via the file picker; %d is how many were added.
#: addon\globalPlugins\freeAudio\radioDialog.py:9070
#, python-format
msgid "%d file added."
msgid_plural "%d files added."
msgstr[0] "បានបន្ថែម %d ឯកសារ។"

#. Translators: Title of the dialog used to add one or more folders to the jukebox at once.
#: addon\globalPlugins\freeAudio\radioDialog.py:9098
msgid "Add folders to the jukebox"
msgstr "បន្ថែមថតទៅ jukebox"

#. Translators: Plural forms spoken after adding several folders to the jukebox in one go (one folder picker used repeatedly); %d is how many folders were added.
#: addon\globalPlugins\freeAudio\radioDialog.py:9126
#, python-format
msgid "%d folder added."
msgid_plural "%d folders added."
msgstr[0] "បានបន្ថែមថត %d។"

#. Translators: Body of the remove-confirmation dialog; %s is the jukebox entry title.
#: addon\globalPlugins\freeAudio\radioDialog.py:9138
#, python-format
msgid "Do you want to remove \"%s\" from the jukebox?"
msgstr "តើអ្នកចង់លុប \"%s\" ចេញពីម៉ាស៊ីនចាក់ចម្រៀងមែនទេ?"

#. Translators: Spoken after successfully removing a jukebox entry; %s is its title.
#: addon\globalPlugins\freeAudio\radioDialog.py:9159
#, python-format
msgid "Removed from jukebox: %s"
msgstr "បានដកចេញពី jukebox: %s"

#. Translators: Spoken after re-scanning a jukebox folder entry for changes on device; %s is the folder's title.
#: addon\globalPlugins\freeAudio\radioDialog.py:9180
#, python-format
msgid "Rescanned: %s"
msgstr "បានស្កេនឡើងវិញ: %s"

#. Translators: Spoken after saving an audio profile for a single jukebox file; %(file)s is its display name.
#: addon\globalPlugins\freeAudio\radioDialog.py:9194
#, python-format
msgid "Audio profile saved for %(file)s"
msgstr "ទម្រង់សំឡេងត្រូវបានរក្សាទុកសម្រាប់ %(file)s"

#. Translators: Spoken after clearing a jukebox file's saved audio profile; %(file)s is its display name.
#: addon\globalPlugins\freeAudio\radioDialog.py:9203
#, python-format
msgid "Audio profile cleared for %(file)s"
msgstr "ទម្រង់សំឡេងត្រូវបានសម្អាតសម្រាប់ %(file)s"

#. Translators: Context-menu item; re-scans a jukebox folder entry for added/removed files on device.
#: addon\globalPlugins\freeAudio\radioDialog.py:9260
msgid "&Rescan Folder"
msgstr "ស្កេនថតឡើងវិញ &R"

#. Translators: Context-menu item; renames the selected jukebox entry (a custom display name, not the underlying file/folder name).
#: addon\globalPlugins\freeAudio\radioDialog.py:9273
msgid "Re&name..."
msgstr ""

#. Translators: Title of the lyrics dialog; %s is the song string (e.g. "Artist - Title").
#: addon\globalPlugins\freeAudio\radioDialog.py:9311
#, python-format
msgid "Lyrics — %s"
msgstr "ពាក្យចម្រៀង — %s"

#. Translators: Heading inside the lyrics dialog restating which song the lyrics are for; %s is the song string.
#: addon\globalPlugins\freeAudio\radioDialog.py:9318
#, python-format
msgid "Lyrics for: %s"
msgstr "ពាក្យចម្រៀងសម្រាប់: %s"

#. Translators: Accessible name for the read-only lyrics text area.
#: addon\globalPlugins\freeAudio\radioDialog.py:9328
msgid "Lyrics"
msgstr "ពាក្យចម្រៀង"

#. Translators: Title of the dialog for manually adding a custom station by stream URL.
#: addon\globalPlugins\freeAudio\radioDialog.py:9358
msgid "Add Custom Station"
msgstr "បន្ថែមស្ថានីយ៍វិទ្យុផ្ទាល់ខ្លួន"

#. Translators: Label for the custom-station name field.
#: addon\globalPlugins\freeAudio\radioDialog.py:9362
msgid "Station name:"
msgstr "ឈ្មោះស្ថានីយ៍វិទ្យុ:"

#. Translators: Label for the custom-station stream-URL field.
#: addon\globalPlugins\freeAudio\radioDialog.py:9367
msgid "Stream URL:"
msgstr "Stream URL:"

#. Translators: Button label; opens Radio Browser's own website to submit this station to their public directory (separate from just adding it locally to freeAudio).
#: addon\globalPlugins\freeAudio\radioDialog.py:9381
msgid "Add to &Radio Browser directory…"
msgstr "បន្ថែមទៅក្នុងថតឯកសារ &Radio Browser…"

#. Translators: Button label; confirms and adds the custom station to favourites.
#: addon\globalPlugins\freeAudio\radioDialog.py:9386
msgid "&Add"
msgstr "បន្ថែម &A"

#. Translators: Status text shown next to the Test URL button when it's pressed with an empty URL field.
#. Translators: Spoken alongside the status text above.
#: addon\globalPlugins\freeAudio\radioDialog.py:9409
#: addon\globalPlugins\freeAudio\radioDialog.py:9411
msgid "Please enter a URL first."
msgstr "សូមបញ្ចូល URL ជាមុនសិន។"

#. Translators: Status text shown next to the Test URL button while the check is in progress.
#: addon\globalPlugins\freeAudio\radioDialog.py:9415
msgid "Checking…"
msgstr "កំពុងពិនិត្យ…"

#. Translators: Spoken when the URL check starts.
#: addon\globalPlugins\freeAudio\radioDialog.py:9417
msgid "Checking stream URL, please wait…"
msgstr "កំពុងពិនិត្យ URL ស្ទ្រីម សូមរង់ចាំ…"

#. Translators: Status text shown next to the Test URL button when the stream checked out as playable; the '✓' is a visual checkmark, not meant to be read as punctuation.
#: addon\globalPlugins\freeAudio\radioDialog.py:9431
msgid "✓ Stream reachable"
msgstr "✓ អាចចូលប្រើស្ទ្រីមបាន"

#. Translators: Spoken when the stream check succeeds.
#: addon\globalPlugins\freeAudio\radioDialog.py:9434
msgid "Stream is reachable."
msgstr "អាចចូលប្រើស្ទ្រីមបាន។"

#. Translators: Status text shown when the stream check failed; the '✗' is a visual cross mark, %s is the specific error from check_stream_url().
#: addon\globalPlugins\freeAudio\radioDialog.py:9437
#, python-format
msgid "✗ %s"
msgstr "✗ %s"

#. Translators: Spoken when the stream check fails; %s is the specific error from check_stream_url().
#: addon\globalPlugins\freeAudio\radioDialog.py:9440
#, python-format
msgid "Stream check failed: %s"
msgstr "ការពិនិត្យស្ទ្រីមបរាជ័យ៖ %s"

#. Translators: Title of the dialog for editing an existing scheduled recording; %s is the station name.
#: addon\globalPlugins\freeAudio\radioDialog.py:9458
#, python-format
msgid "Edit Schedule — %s"
msgstr "កែសម្រួលកាលវិភាគ — %s"

#. Translators: 'Save' button label; commits the edited schedule entry.
#: addon\globalPlugins\freeAudio\radioDialog.py:9542
msgid "&Save"
msgstr "រក្សាទុក &S"

#. Translators: Fallback episode title used for the downloaded filename if the currently playing episode has no name.
#. Translators: Field-name row header in this dialog's podcast-episode details table; value is the episode title.
#: addon\globalPlugins\freeAudio\recordingMixin.py:44
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:831
msgid "Episode"
msgstr "ភាគ"

#. Translators: Spoken when trying to download the current podcast episode but it has no resolvable URL.
#: addon\globalPlugins\freeAudio\recordingMixin.py:48
msgid "This episode has no downloadable URL."
msgstr "ភាគនេះគ្មាន URL សម្រាប់ទាញយកទេ។"

#. Translators: Name of an NVDA command (Ctrl+Win+E); single-press toggles a plain instant recording, double-press toggles song-capture recording instead - see this method's logic below.
#: addon\globalPlugins\freeAudio\recordingMixin.py:74
msgid "Start or stop instant recording"
msgstr "ចាប់ផ្តើម ឬបញ្ឈប់ដំណើរការថតភ្លាមៗ"

#. Translators: Spoken when the user manually ends an in-progress song-capture recording (double-press Ctrl+Win+E while capturing); %s is the saved filename.
#: addon\globalPlugins\freeAudio\recordingMixin.py:102
#, python-format
msgid "Song recording stopped: %s"
msgstr "ការ​ថត​បទចម្រៀង​បាន​បញ្ឈប់: %s"

#. Translators: Fallback spoken when song-capture is stopped but no output path was returned (e.g. nothing was actually captured).
#. Translators: Fallback spoken when auto-stop finds nothing to save (e.g. capture just started).
#: addon\globalPlugins\freeAudio\recordingMixin.py:106
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:1224
msgid "Song recording stopped"
msgstr "ការ​ថត​បទចម្រៀង​បាន​បញ្ឈប់"

#. Translators: Spoken when double-pressing Ctrl+Win+E (song-capture) on a podcast/audiobook episode, which can't be recorded this way; points to the Ctrl+Win+V download command instead.
#. Translators: Same message as the song-capture path above, spoken here when single-pressing Ctrl+Win+E on a podcast/audiobook episode.
#: addon\globalPlugins\freeAudio\recordingMixin.py:140
#: addon\globalPlugins\freeAudio\recordingMixin.py:225
msgid ""
"Podcast or audiobook cannot be recorded. To download the episode or book, "
"press Ctrl+Win+V."
msgstr "ផតខាស់ ឬសៀវភៅជាសំឡេង មិនអាចថតបានទេ។ ដើម្បីទាញយកភាគ ឬសៀវភៅ សូមចុច Ctrl+Win+V។"

#. Translators: Spoken when double-pressing Ctrl+Win+E (song-capture) on a jukebox track, which is already a local file.
#. Translators: Same message as the song-capture path above, spoken here when single-pressing Ctrl+Win+E on a jukebox track.
#: addon\globalPlugins\freeAudio\recordingMixin.py:149
#: addon\globalPlugins\freeAudio\recordingMixin.py:233
msgid "Jukebox tracks are already local files and cannot be recorded."
msgstr "បទនៅក្នុង jukebox ជាឯកសារមូលដ្ឋានរួចហើយ ដូច្នេះមិនអាចថតបានទេ។"

#. Translators: Spoken when trying to start song-capture recording on a station with no ICY track-title metadata, so there's no song boundary to record against.
#: addon\globalPlugins\freeAudio\recordingMixin.py:167
msgid ""
"This station does not broadcast track metadata. Song recording is not "
"available."
msgstr ""
"ស្ថានីយវិទ្យុនេះមិនផ្សាយទិន្នន័យមេតានៃបទចម្រៀង ឬតន្ត្រីទេ។ "
"ដំណើរការថតបទចម្រៀងមិនអាចចាប់ផ្ដើមបានទេ។"

#. Translators: Spoken when song-capture recording starts; %s is the current ICY track title (artist/song) being captured.
#: addon\globalPlugins\freeAudio\recordingMixin.py:180
#, python-format
msgid "Song recording started: %s"
msgstr "ដំណើរការថតបទចម្រៀងបានចាប់ផ្តើមហើយ: %s"

#. Translators: Generic fallback spoken if starting song-capture recording raises an unexpected exception.
#: addon\globalPlugins\freeAudio\recordingMixin.py:185
msgid "Could not start song recording"
msgstr "មិនអាចចាប់ផ្តើមដំណើរការថតបទចម្រៀងបានទេ"

#. Translators: Spoken when the single-press gesture stops an in-progress plain instant recording; %s is the saved filename.
#: addon\globalPlugins\freeAudio\recordingMixin.py:215
#, python-format
msgid "Recording stopped: %s"
msgstr "ដំណើរការថតបានបញ្ឈប់ហើយ: %s"

#. Translators: Fallback spoken when a recording is stopped but no output path was returned.
#: addon\globalPlugins\freeAudio\recordingMixin.py:218
msgid "Recording stopped"
msgstr "ដំណើរការថតបានបញ្ឈប់ហើយ"

#. Translators: Spoken when a plain instant recording starts (single-press Ctrl+Win+E); %s is the station name.
#. Translators: Spoken when a scheduled or manual recording begins; %s is the station name.
#: addon\globalPlugins\freeAudio\recordingMixin.py:245
#: addon\globalPlugins\freeAudio\__init__.py:584
#, python-format
msgid "Recording started: %s"
msgstr "ដំណើរការថតបានចាប់ផ្ដើមហើយ: %s"

#. Translators: Generic fallback spoken if starting an instant recording raises an unexpected exception.
#: addon\globalPlugins\freeAudio\recordingMixin.py:249
msgid "Could not start recording"
msgstr "មិនអាចចាប់ផ្តើមដំណើរការថតបានទេ"

#. Translators: Name of an NVDA command (Ctrl+Win+W); opens the configured recordings folder in File Explorer.
#: addon\globalPlugins\freeAudio\recordingMixin.py:256
msgid "Open freeAudio recordings folder"
msgstr "បើកឯកសារថតរបស់ freeAudio"

#. Translators: Spoken when the Ctrl+Win+W shortcut can't open the recordings folder in Explorer; %s is the underlying error.
#: addon\globalPlugins\freeAudio\recordingMixin.py:271
#, python-format
msgid "Could not open recordings folder: %s"
msgstr "មិនអាចបើកឯកសារថតបានទេ: %s"

#. Translators: Checkbox label for the time-shift/rewind feature setting.
#: addon\globalPlugins\freeAudio\settingsPanel.py:89
msgid ""
"&Enable time-shift buffer (rewind live radio, no effect on podcasts and "
