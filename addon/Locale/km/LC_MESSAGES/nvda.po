#: addon\globalPlugins\freeAudio\radioDialog.py:8422
msgid "Add &File..."
msgstr "បន្ថែម&ឯកសារ..."

#. Translators: Button label; adds a whole folder (via a folder picker) to the jukebox library.
#: addon\globalPlugins\freeAudio\radioDialog.py:8424
msgid "Add F&older..."
msgstr "បន្ថែម&ថត..."

#. Translators: Button label; removes the selected file/folder from the jukebox library.
#: addon\globalPlugins\freeAudio\radioDialog.py:8426
msgid "&Remove"
msgstr "ដកចេញ &R"

#. Translators: Button label; opens a file-save dialog to export the jukebox library (JSON or M3U).
#: addon\globalPlugins\freeAudio\radioDialog.py:8440
#, fuzzy
msgid "E&xport Jukebox..."
msgstr "នាំ&ចេញបញ្ជីចំណូលចិត្ត..."

#. Translators: Button label; opens a file-picker to import jukebox entries from a JSON or M3U file.
#: addon\globalPlugins\freeAudio\radioDialog.py:8443
#, fuzzy
msgid "&Import Jukebox..."
msgstr "នាំ&ចូលបញ្ជីចំណូលចិត្ត..."

#. Translators: Spoken when a jukebox device search starts; %s is the search text.
#: addon\globalPlugins\freeAudio\radioDialog.py:8538
#, python-format
