#. Translators: Spoken when a book download starts; %s is the book title.
#: addon\globalPlugins\freeAudio\radioDialog.py:8310
#, python-format
msgid "Downloading book: %s"
msgstr "កំពុងទាញយកសៀវភៅ៖ %s"

