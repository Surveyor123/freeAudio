#: addon\globalPlugins\freeAudio\radioDialog.py:8347
#, python-format
msgid ""
"Downloaded %(saved)d of %(total)d parts of %(title)s. Last error: %(error)s"
msgstr ""
"បានទាញយក %(saved)d ក្នុងចំណោម %(total)d ផ្នែកនៃ %(title)s។ កំហុសចុងក្រោយ៖ %(error)s"

#. Translators: Label for the jukebox device-search field.
#: addon\globalPlugins\freeAudio\radioDialog.py:8374
msgid "Search on devices:"
msgstr "ស្វែងរកក្នុងថាស:"

#. Translators: Accessible name/hint for the jukebox device-search field: searches local audio files by filename.
#: addon\globalPlugins\freeAudio\radioDialog.py:8377
msgid "Search audio files on your computer by filename. Press enter to search"
msgstr "ស្វែងរកឯកសារសំឡេងនៅលើកុំព្យូទ័ររបស់អ្នកតាមឈ្មោះឯកសារ។ ចុច Enter ដើម្បីស្វែងរក"

#. Translators: Accessible name for the device-search results list.
#: addon\globalPlugins\freeAudio\radioDialog.py:8390
msgid "Audio files found on your devices"
msgstr "ឯកសារសំឡេងដែលរកឃើញនៅលើថាស"

#. --- Jukebox entries (manually added files/folders) ---
#. Translators: Label above the list of files/folders already added to the jukebox library.
#: addon\globalPlugins\freeAudio\radioDialog.py:8401
msgid "Jukebox:"
msgstr "Jukebox:"

#. Translators: Accessible name for the jukebox library list.
#: addon\globalPlugins\freeAudio\radioDialog.py:8404
msgid "Files and folders in your jukebox"
