#: addon\globalPlugins\freeAudio\legacyMigration.py:179
msgid ""
"The previous version of this add-on, FreeRadio, is still installed alongside "
"freeAudio. Running both at the same time makes them compete for the same "
"shortcuts and audio device. Your settings and data have been copied to "
"freeAudio. Please uninstall FreeRadio (NVDA menu, Tools, Add-on Store or "
"Manage add-ons) and restart NVDA."
msgstr ""
"الإصدار السابق من هذه الإضافة، FreeRadio، لا يزال مثبتًا إلى جانب freeAudio. "
"يؤدي تشغيلهما معًا إلى تنافسهما على الاختصارات نفسها وعلى جهاز الصوت نفسه. "
"لقد نُسخت إعداداتك وبياناتك إلى freeAudio. يرجى إلغاء تثبيت FreeRadio (قائمة "
"NVDA، الأدوات، متجر الإضافات أو إدارة الإضافات) ثم إعادة تشغيل NVDA."

#. Translators: Fixed source label for LibriVox audiobooks, shown in the station-details dialog and the Audio Books tab (same role as getem.py's/gutenberg_audiobooks.py's 'audiobook_source').
#. Translators: Source-name label for a book from the LibriVox catalog, shown alongside the audio-book details.
#: addon\globalPlugins\freeAudio\librivox.py:339
#: addon\globalPlugins\freeAudio\radioDialog.py:7006
#: addon\globalPlugins\freeAudio\settingsPanel.py:516
msgid "LibriVox"
msgstr "LibriVox"

#. Translators: Error returned when a LibriVox book has no linked RSS feed (used as a fallback path when archive.org's own file listing didn't work) to read chapters from.
#: addon\globalPlugins\freeAudio\librivox.py:536
msgid "This book has no LibriVox RSS feed to read chapters from."
msgstr "لا يحتوي هذا الكتاب على خلاصة RSS من LibriVox لقراءة الفصول منها."

#. Translators: Error returned when a LibriVox RSS feed contains XML entity declarations, which are rejected as a security measure against entity-expansion attacks.
#: addon\globalPlugins\freeAudio\librivox.py:545
msgid "The feed contains XML entity declarations and was rejected."
msgstr "تحتوي الخلاصة على تعريفات كيانات XML وتم رفضها."

#. Translators: Error returned when the book's LibriVox RSS feed could not be fetched or parsed.
#: addon\globalPlugins\freeAudio\librivox.py:555
msgid "Could not read this book's chapter list."
msgstr "تعذّرت قراءة قائمة فصول هذا الكتاب."

#. Translators: Error returned when the LibriVox RSS feed was read successfully but contains no playable audio items.
#: addon\globalPlugins\freeAudio\librivox.py:569
msgid "No playable audio file was found in this book's LibriVox feed."
msgstr "لم يُعثر على ملف صوتي قابل للتشغيل في خلاصة LibriVox لهذا الكتاب."

#. Translators: Name of an NVDA command; mutes/unmutes all of freeAudio's spoken notifications (station changes, playback state, recording, volume level) at once.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:34
msgid ""
"Toggle mute notifications (station changes, playback, recording, volume "
"level)"
msgstr "تبديل كتم الإشعارات (تغيير المحطة، والتشغيل، والتسجيل، ومستوى الصوت)"

#. Notifications are now muted — speak this final confirmation before silencing.
#. Translators: Spoken once, right before notifications go silent, to confirm the toggle happened (further notifications are suppressed after this).
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:44
msgid "Notifications muted"
msgstr "كُتمت الإشعارات"

#. Translators: Spoken when notifications are turned back on.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:47
msgid "Notifications unmuted"
msgstr "أُلغي كتم الإشعارات"

#. Translators: Name of an NVDA command; toggles whether freeAudio announces a station's track/song changes from ICY stream metadata.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:53
msgid "Enable or disable auto-announce track changes (ICY metadata)"
msgstr "تمكين أو تعطيل الإعلان التلقائي عن تغييرات المسار (بيانات ICY الوصفية)"

#. Translators: Feature name reused as both the settings-panel checkbox label (with '&' marking its access key) and, with the '&' stripped, as %(effect)s in the toggle announcement above.
#. Translators: Checkbox label for the track-change announcement setting (same feature as the toggleAnnounceTrackChanges command).
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:78
#: addon\globalPlugins\freeAudio\settingsPanel.py:247
msgid "&Auto-announce track changes (ICY metadata)"
msgstr "الإعلان الت&لقائي عن تغييرات المقاطع (بيانات ICY الوصفية)"

#. Translators: Name of an NVDA command; switches which voice (NVDA's current synth, or a separate SAPI5 voice) speaks track-change announcements.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:85
msgid "Switch track change announcement voice"
msgstr "تبديل صوت إعلان تغيير المسار"

#. Translators: Name of an NVDA command; toggles whether liked/favourited songs are also appended to a plain text file on disk.
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:107
msgid "Turn on or off saving liked songs to a text file"
msgstr "تشغيل أو إيقاف حفظ الأغاني المعجب بها في ملف نصي"

#. Translators: Feature name for the save-liked-songs toggle, used the same way as the track-change one above (checkbox label with '&' access key, and %(effect)s with it stripped).
#. Translators: Checkbox label for the save-liked-songs setting (same feature as the toggleSaveLikedSongs command).
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:127
#: addon\globalPlugins\freeAudio\settingsPanel.py:339
msgid "&Save liked songs to a text file"
msgstr "ح&فظ الأغاني المعجب بها في ملف نصي"

#. Translators: Raised internally when the captured audio snippet has no detectable frequency content to fingerprint (e.g. silence or dead air); surfaces as a recognition failure.
#: addon\globalPlugins\freeAudio\musicRecognizer.py:616
msgid "No frequency peaks found — audio may be silence"
msgstr "لم يُعثر على قمم ترددية — قد يكون الصوت صامتًا"

#. Translators: Raised when Shazam's API responds but has no match for the submitted audio fingerprint.
#: addon\globalPlugins\freeAudio\musicRecognizer.py:666
msgid "Song not recognized"
msgstr "لم يتم التعرف على الأغنية"

#: addon\globalPlugins\freeAudio\musicRecognizer.py:732
msgid ""
"ffmpeg.exe not found. Download ffmpeg from https://ffmpeg.org/download.html "
"and place ffmpeg.exe in the freeAudio addon folder, or set the path in "
"settings."
msgstr ""
"لم يتم العثور على ffmpeg.exe. قم بتنزيله من https://ffmpeg.org/download.html "
"وضعه في مجلد إضافة freeAudio، أو قم بتعيين مساره في الإعدادات."

#. Translators: Title of the Obligato mode setup dialog.
#: addon\globalPlugins\freeAudio\obligatoMixin.py:55
