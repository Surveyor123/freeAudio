#. shares the same kind of narration, so one fixed, honest label is more
#. useful here than an empty field.
#. Translators: Fixed narrator label shown for every book in this AI-narrated collection, in place of a per-book human reader's name.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:137
msgid "AI-generated narration (Microsoft neural text-to-speech)"
msgstr "سرد مولَّد بالذكاء الاصطناعي (تحويل النص إلى كلام العصبي من Microsoft)"

#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:215
#, python-format
msgid "AI narration, %s"
msgstr "سرد بالذكاء الاصطناعي، %s"

#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:217
msgid "AI narration"
msgstr "سرد بالذكاء الاصطناعي"

#. Translators: %s = the specific AI voice name, e.g. "SteffanNeural"
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:300
