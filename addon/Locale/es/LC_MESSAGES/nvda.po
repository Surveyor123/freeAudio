msgstr "Aún no se han encontrado versiones en GitHub."

#. Translators: Spoken during a manual update check when the GitHub API request itself returns an HTTP error; %d is the HTTP status code.
#: addon\globalPlugins\freeAudio\__init__.py:1380
#, python-format
msgid "Update check failed (HTTP %d)."
msgstr "Error en la comprobación de actualización (HTTP %d)."

#. Translators: Spoken during a manual update check when the request to GitHub fails outright (e.g. no internet connection).
#: addon\globalPlugins\freeAudio\__init__.py:1386
msgid "Update check failed. Please check your internet connection."
msgstr ""
"Error en la comprobación de actualización. Por favor revisa tu conexión a "
"Internet."

