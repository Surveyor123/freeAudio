#: addon\globalPlugins\freeAudio\trackInfoMixin.py:622
#, python-format
msgid ""
"The following recordings are active and will be stopped:\n"
"%s\n"
"\n"
"Stop radio and end all recordings?"
msgstr ""
"Las siguientes grabaciones están activas y se detendrán:\n"
"%s\n"
"\n"
"¿Detener la radio y finalizar todas las grabaciones?"

#. Translators: Title of the confirmation dialog shown when stopping playback would cut off active recordings.
#. Translators: Title of the F8 stop-confirmation dialog.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:212
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:630
msgid "Active Recordings"
msgstr "Grabaciones activas"

#. Translators: Spoken after confirming the stop when active recordings were involved.
#. Translators: Spoken when the stop command is used and there were no active recordings to confirm about.
#. Translators: Spoken by F8 (stop) after confirming the stop and ending any active recordings.
#. Translators: Spoken by F8 (stop) when there were no active recordings to confirm about.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:226
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:238
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:644
#: addon\globalPlugins\freeAudio\trackInfoMixin.py:658
msgid "freeAudio stopped"
msgstr "freeAudio detenido"

#. Translators: Name of an NVDA command; skips to the next station in the favourites list.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:242
msgid "Play next station"
msgstr "Reproducir la siguiente estación"

#. Translators: Name of an NVDA command; skips to the previous station in the favourites list.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:279
msgid "Play previous station"
msgstr "Reproducir la estación anterior"

#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:723
msgid ""
"Could not resume the last audio book - it may have been removed from your "
"library."
msgstr ""
"No se pudo reanudar el último audiolibro; es posible que se haya eliminado "
"de tu biblioteca."

#. Translators: Fallback station name used in log/error contexts if the station dict has no name field.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:761
msgid "Unknown station"
msgstr "Estación desconocida"

#. Translators: Spoken by the pitch-transpose commands when the current transpose value is back to 0 (no pitch shift applied).
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:975
msgid "Normal pitch"
msgstr "Tono normal"

#. Translators: %.2f = signed semitone value, e.g. "+1.25 semitones"
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:977
#, python-format
msgid "%+.2f semitones"
msgstr "%+.2f semitonos"

#. Translators: Name of an NVDA command; raises the pitch of podcasts/audio books/jukebox tracks without changing playback speed.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:981
msgid "Raise pitch transpose (podcasts, audio books and jukebox tracks)"
msgstr ""
"Subir el tono  de transposición (podcasts, audiolibros y pistas del jukebox)"

#. Translators: Spoken when the pitch-transpose commands are used while playing a live radio station rather than a podcast/audiobook/jukebox track.
#. Translators: Same as the transposeUp case above: spoken when transpose is used on a live radio station.
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:991
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:1010
msgid "Transpose only applies to podcasts, audio books and jukebox tracks"
msgstr ""
