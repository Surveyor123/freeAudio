#: addon\globalPlugins\freeAudio\jukebox.py:1228
#, python-format
msgid "Folder not found: %s"
msgstr "Папка не найдена: %s"

#. Translators: Error returned by JukeboxManager.add_folder() when the folder was scanned but contains no recognized audio files.
#: addon\globalPlugins\freeAudio\jukebox.py:1236
msgid "No audio files found in that folder."
msgstr "В этой папке не найдено аудиофайлов."

#: addon\globalPlugins\freeAudio\jukebox.py:1347
msgid "Not a valid jukebox export file."
msgstr ""

#: addon\globalPlugins\freeAudio\jukebox.py:1397
