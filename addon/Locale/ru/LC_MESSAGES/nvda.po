#: addon\globalPlugins\freeAudio\audioFxMixin.py:230 addon\globalPlugins\freeAudio\legacyMigration.py:185
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:35 addon\globalPlugins\freeAudio\miscTogglesMixin.py:54
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:86
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:108 addon\globalPlugins\freeAudio\obligatoMixin.py:206
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:84
#: addon\globalPlugins\freeAudio\playbackCoreMixin.py:184
