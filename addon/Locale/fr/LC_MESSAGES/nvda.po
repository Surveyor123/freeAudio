msgstr "activé"

#. Translators: EQ band state word spoken after the EQ band name when the band is turned off, e.g. "EQ: Bass Boost disabled".
#. Translators: Effect state word spoken after the effect name when the effect is turned off, e.g. "Echo disabled".
#: addon\globalPlugins\freeAudio\audioFxMixin.py:235
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:80
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:129
#: addon\globalPlugins\freeAudio\radioDialog.py:1853
#: addon\globalPlugins\freeAudio\radioDialog.py:1870
#: addon\globalPlugins\freeAudio\radioDialog.py:1900
#: addon\globalPlugins\freeAudio\settingsPanel.py:710
#: addon\globalPlugins\freeAudio\settingsPanel.py:722
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:449
msgid "disabled"
msgstr "désactivé"

#. Translators: Name of an NVDA command; cycles the sound effect played when switching stations (crossfade/instant cut/tuning effect).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:241
msgid "Toggle station switch transition (crossfade)"
msgstr ""
"Activer/désactiver transition de changement de station (fondu enchaîné)"

#. Translators: One of the station-transition modes cycled by the crossfade command: plays no transition sound, cuts instantly.
#. Translators: Choices for the crossfade setting, same wording and order as the in-app toggleStationTransition command's cycle (audioFxMixin.py) - continues for the next three lines.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:250
#: addon\globalPlugins\freeAudio\settingsPanel.py:227
msgid "Instant cut (no crossfade)"
msgstr "Coupe instantanée (pas de fondu enchaîné)"

#. Translators: One of the station-transition modes: a brief 1-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:252
#: addon\globalPlugins\freeAudio\settingsPanel.py:228
msgid "Short crossfade (1 second)"
msgstr "Fondu enchaîné court (1 seconde)"

#. Translators: One of the station-transition modes: a longer 2-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:254
#: addon\globalPlugins\freeAudio\settingsPanel.py:229
msgid "Normal crossfade (2 seconds)"
msgstr "Fondu enchaîné normal (2 secondes)"

#. Translators: One of the station-transition modes: plays a radio-tuning sound effect instead of a crossfade.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:256
#: addon\globalPlugins\freeAudio\settingsPanel.py:230
msgid "Station tuning sound effect"
msgstr "Effet sonore de syntonisation de station"

#. Translators: Name of an NVDA command; toggles the "Weird" audio effect on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:287
msgid "Toggle Weird"
msgstr "Activer/désactiver Étrange"

#. Translators: Spoken when the "Weird" audio effect is turned on with its command.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:305
msgid "Weird enabled"
msgstr "Étrange activé"

#. Translators: Spoken when the "Weird" audio effect is turned off with its command.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:307
msgid "Weird disabled"
msgstr "Étrange désactivé"

#. Translators: Name of an NVDA command; turns the ten-band graphic equalizer on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:312
msgid "Toggle Equalizer"
msgstr "Activer/désactiver l'Égaliseur"

#. Translators: Spoken when the ten-band graphic equalizer is turned on with its command.
#. Translators: Spoken when the equalizer is turned on with the checkbox.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:325
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:72
msgid "Equalizer enabled"
msgstr "Égaliseur activé"

#. Translators: Spoken when the ten-band graphic equalizer is turned off with its command.
#. Translators: Spoken when the equalizer is turned off with the checkbox.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:327
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:74
msgid "Equalizer disabled"
msgstr "Égaliseur désactivé"

#. Translators: Name of an NVDA command; adds a bookmark at the current playback position of an audio book part, podcast episode or jukebox track.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:39
msgid "Add a bookmark at the current position (audio books, podcasts, jukebox)"
msgstr ""
"Ajouter un signet à la position actuelle (livres audio, podcasts, jukebox)"

#. Translators: Spoken when the add-bookmark command is used on a live radio station.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:55
msgid ""
"Bookmarks are available for audio books, podcasts and jukebox tracks only"
msgstr ""
"Les signets sont disponibles uniquement pour les livres audio, les podcasts "
"et les morceaux du jukebox"

#. Translators: Spoken when the current playback position can't be read, so no bookmark is added.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:62
msgid "Could not read the playback position"
msgstr "Impossible de lire la position de lecture"

#. Translators: Spoken after adding a bookmark; %(name)s is its default name (ordinal), %(time)s the position.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:67
#, python-format
msgid "Bookmark added: %(name)s, %(time)s"
msgstr "Signet ajouté: %(name)s, %(time)s"

#. Translators: Default name of a bookmark; %d is its ordinal among the item's bookmarks, sorted by position.
#: addon\globalPlugins\freeAudio\bookmarks.py:142
#, python-format
msgid "Bookmark %d"
msgstr "Signet %d"

#. Translators: Fallback default bookmark name if its ordinal can't be determined.
#: addon\globalPlugins\freeAudio\bookmarks.py:144
msgid "Bookmark"
msgstr "Signet"

#. Translators: Title of the dialog used to record a voice note for a bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:74
msgid "Voice Note"
msgstr "Note vocale"

#. Translators: Text of the voice-note recording dialog.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:80
msgid "Recording from the microphone. Press Stop and Save when you are done."
msgstr ""
"Enregistrement via le microphone. Appuyez sur Arrêter et Enregistrer une "
"fois terminé."

#. Translators: Button label; stops the voice-note recording and saves it to the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:85
msgid "&Stop and Save"
msgstr "&Arrêter et Enregistrer"

#. Translators: Spoken when the microphone can't be opened for a voice note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:102
msgid "Could not start recording. Check that a microphone is available."
msgstr ""
"L'enregistrement n'a pas pu démarrer. Veuillez vérifier la disponibilité "
"d'un microphone."

#. Translators: Spoken when voice-note recording has started.
#. Translators: Tab label for the recording controls and active/past recordings list.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:106
#: addon\globalPlugins\freeAudio\radioDialog.py:715
msgid "Recording"
msgstr "Enregistrement"

#. Translators: Spoken when the recorded voice note could not be saved.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:113
msgid "Could not save the voice note"
msgstr "Impossible d'enregistrer le message vocal"

#. Translators: Label above the list of bookmarks of the selected podcast episode / audio book / jukebox track.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:142
msgid "Bookmarks:"
msgstr "Signets:"

#. Translators: Accessible name of the bookmarks list.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:145
msgid "Bookmarks of the selected item"
msgstr "Signets de l'élément sélectionné"

#. Translators: Marker appended to a bookmark's list row when it has a text note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:163
msgid "[text]"
msgstr "[texte]"

#. Translators: Marker appended to a bookmark's list row when it has a voice note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:166
msgid "[voice note]"
msgstr "[note vocale]"

#. Translators: Spoken after unmarking a bookmark; %s is its name.
#. Translators: Spoken after unmarking a favourite station in the multi-select removal flow; %s is the station name.
#. Translators: Spoken after unmarking a liked song in the multi-select removal flow; %s is the song string.
#. Translators: Spoken after unmarking an audio book in the multi-select removal flow; %s is the book title.
#. Translators: Spoken after unmarking a jukebox entry in the multi-select removal flow; %s is the entry title.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:254
#: addon\globalPlugins\freeAudio\radioDialog.py:5304
#: addon\globalPlugins\freeAudio\radioDialog.py:6122
#: addon\globalPlugins\freeAudio\radioDialog.py:8310
#: addon\globalPlugins\freeAudio\radioDialog.py:9508
#, python-format
msgid "Unmarked: %s"
msgstr "Non marqué: %s"

#. Translators: Spoken after marking a bookmark; %s is its name.
#. Translators: Spoken after marking a favourite station in the multi-select removal flow; %s is the station name.
#. Translators: Spoken after marking a liked song in the multi-select removal flow; %s is the song string.
#. Translators: Spoken after marking an audio book in the multi-select removal flow; %s is the book title.
#. Translators: Spoken after marking a jukebox entry in the multi-select removal flow; %s is the entry title.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:258
#: addon\globalPlugins\freeAudio\radioDialog.py:5308
#: addon\globalPlugins\freeAudio\radioDialog.py:6126
#: addon\globalPlugins\freeAudio\radioDialog.py:8314
#: addon\globalPlugins\freeAudio\radioDialog.py:9512
#, python-format
msgid "Marked: %s"
msgstr "Marqué: %s"

#. Translators: Prompt of the bookmark rename dialog; leaving it empty restores the default name.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:299
msgid "Enter a new name for the bookmark (leave empty for the default name):"
msgstr ""
"Saisissez un nouveau nom pour le signet (laissez vide pour conserver le nom "
"par défaut):"

#. Translators: Title of the bookmark rename dialog.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:301
msgid "Rename Bookmark"
msgstr "Renommer le signet"

#. Translators: Spoken after renaming a bookmark; %s is its new name.
#. Translators: Spoken after successfully renaming a station; %s is the new name.
#. Translators: Spoken after successfully renaming a jukebox entry; %s is the new name.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:314
#: addon\globalPlugins\freeAudio\radioDialog.py:3511
#: addon\globalPlugins\freeAudio\radioDialog.py:5398
#, python-format
msgid "Renamed to: %s"
msgstr "Renommé en: %s"

#: addon\globalPlugins\freeAudio\bookmarkUI.py:325
#, python-format
msgid "Do you want to delete %d bookmark?"
msgid_plural "Do you want to delete %d bookmarks?"
msgstr[0] "Voulez-vous supprimer le signet %d ?"
msgstr[1] "Voulez-vous supprimer les signets %d ?"

#. Translators: Title of the delete-bookmarks confirmation dialog.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:330
msgid "Delete Bookmarks"
msgstr "Supprimer les signets"

#. Translators: Spoken after deleting bookmarks; %d is how many were deleted.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:342
#, python-format
msgid "%d bookmark deleted"
msgid_plural "%d bookmarks deleted"
msgstr[0] "%d signet supprimé"
msgstr[1] "%d signets supprimés"

#. Translators: Prompt of the bookmark text-note dialog; the text is spoken by NVDA when playback reaches the bookmark. Empty removes the text.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:355
msgid ""
"Text spoken when playback reaches this bookmark (leave empty to remove it):"
msgstr ""
"Texte lu lorsque la lecture atteint ce signet (laisser vide pour le "
"supprimer):"

#. Translators: Title of the bookmark text-note dialog.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:357
msgid "Bookmark Text"
msgstr "Texte du signet"

#. Translators: Spoken after saving a bookmark's text note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:369
msgid "Text saved"
msgstr "Texte enregistré"

#: addon\globalPlugins\freeAudio\bookmarkUI.py:369
msgid "Text removed"
msgstr "Texte supprimé"

#. Translators: Spoken after a voice note was saved to a bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:384
msgid "Voice note saved"
msgstr "Note vocale enregistrée"

#. Translators: Spoken after removing a bookmark's text and voice notes.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:395
msgid "Notes removed"
msgstr "Notes supprimées"

#. Translators: Spoken when the repeat command is used without two or more marked bookmarks of the same item.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:404
msgid "Mark at least two bookmarks of the same item with the period key first."
msgstr ""
"Marquer au moins deux signets du même élément en utilisant d'abord la touche "
"point."

#. Translators: Spoken when repeat mode starts; %(start)s and %(end)s are the positions it repeats between.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:421
#, python-format
msgid "Repeating between %(start)s and %(end)s"
msgstr "Répéter entre %(start)s et %(end)s"

#. Translators: Spoken when repeat mode between bookmarks is turned off.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:427
msgid "Repeat stopped"
msgstr "Répétition arrêtée"

#. Translators: Spoken when the marked bookmarks are (almost) at the same position, so there is nothing to save as an excerpt.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:443
msgid "The marked bookmarks are too close together to save an excerpt."
msgstr ""
"Les signets marqués sont trop proches les uns des autres pour enregistrer un "
"extrait."

#. Translators: Spoken when an audio excerpt can't be saved because the source of the item isn't known.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:451
msgid "Could not find the audio of this item."
msgstr "Impossible de trouver le fichier audio de cet élément."

#. Translators: Spoken when saving the audio between two bookmarks starts.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:459
msgid "Saving excerpt..."
msgstr "Enregistrement d'un extrait..."

#. Translators: Spoken when an audio excerpt was saved; %s is the file name.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:463
#, python-format
msgid "Excerpt saved: %s"
msgstr "Extrait enregistré: %s"

#. Translators: Spoken when an audio excerpt can't be saved because ffmpeg could not be found.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:468
msgid "Could not save the excerpt: ffmpeg was not found."
msgstr "Impossible d'enregistrer l'extrait: ffmpeg est introuvable."

#. Translators: Spoken when saving an audio excerpt failed; %s is the error.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:471
#, python-format
msgid "Could not save the excerpt: %s"
msgstr "Impossible d'enregistrer l'extrait: %s"

#. Translators: Spoken when the same excerpt is already being saved.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:478
msgid "This excerpt is already being saved."
msgstr "Cet extrait est déjà enregistré."

#. Translators: Bookmark context-menu item; plays the item starting at the selected bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:496
msgid "&Play from Bookmark"
msgstr "&Lire depuis le signet"

#. Translators: Bookmark context-menu item; renames the selected bookmark.
#. Translators: Context-menu item; renames the selected jukebox entry (a custom display name, not the underlying file/folder name).
#: addon\globalPlugins\freeAudio\bookmarkUI.py:498
#: addon\globalPlugins\freeAudio\radioDialog.py:9871
msgid "Re&name..."
msgstr "Re&nommer..."

#. Translators: Bookmark context-menu item; deletes the bookmarks marked with '.' (or the focused one if none are marked).
#: addon\globalPlugins\freeAudio\bookmarkUI.py:500
msgid "&Delete Selected"
msgstr "&Supprimer la sélection"

#. Translators: Bookmark context-menu item; adds or edits a text note spoken by NVDA when playback reaches the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:503
msgid "Add or Edit &Text..."
msgstr "Ajouter ou modifier du &texte..."

#. Translators: Bookmark context-menu item; records a voice note that plays when playback reaches the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:505
msgid "Add &Voice Note..."
msgstr "Ajouter une note &vocale..."

#. Translators: Bookmark context-menu item; removes the text and voice note of the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:507
msgid "&Clear Notes"
msgstr "&Effacer les notes"

#. Translators: Bookmark context-menu item; plays the section between the bookmarks marked with '.' over and over.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:510
msgid "&Repeat Between Marked Bookmarks"
msgstr "&Répéter entre les signets marqués"

#. Translators: Bookmark context-menu item; turns off the repeat mode.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:512
msgid "St&op Repeat"
msgstr "Arrêt&er la répétition"

#. Translators: Bookmark context-menu item; saves the section between the bookmarks marked with '.' as an audio file in the recordings folder, in a folder named after the media.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:515
msgid "Save &Excerpt Between Marked Bookmarks"
msgstr "Enregistrer l'&extrait entre les signets marqués"

#. Translators: Fixed source label for GETEM audiobooks, shown in the station-details dialog and the Audio Books tab (same role as gutenberg_audiobooks.py's 'audiobook_source').
#. Translators: Source-name label for a book from GETEM (Boğaziçi University audio e-library) - the fallback when the book is neither LibriVox nor Project Gutenberg.
#. Reuses the exact same bare "GETEM"/"LibriVox"/"Project Gutenberg"
#. strings RadioDialog._audiobook_source_label_for() already shows
#. next to each book in the Audio Books tab, rather than
#. introducing new, differently-worded translations for the same
#. three names.
#. Translators: Names in the audio-book-sources checklist below; see the comment above for why these reuse RadioDialog's existing source-label strings rather than new translations.
#: addon\globalPlugins\freeAudio\getem.py:568
#: addon\globalPlugins\freeAudio\radioDialog.py:7671
#: addon\globalPlugins\freeAudio\settingsPanel.py:524
msgid "GETEM"
msgstr "GETEM"

#. Translators: Error returned by GetemSession.login() when freeAudio has no saved GETEM credentials at all.
#: addon\globalPlugins\freeAudio\getem.py:652
msgid "Please enter your GETEM username and password in freeAudio's settings."
msgstr ""
"Veuillez saisir votre nom d'utilisateur et votre mot de passe GETEM dans les "
"paramètres de freeAudio."

#. Translators: Error returned by GetemSession.login() when the GETEM server rejects the saved username/password.
#: addon\globalPlugins\freeAudio\getem.py:686
msgid "GETEM login failed. Please check your username and password."
msgstr ""
"La connexion GETEM a échoué. Veuillez vérifier votre nom d'utilisateur et "
"votre mot de passe."

#. Translators: Error returned before attempting login when the settings dialog's GETEM username/password fields are empty.
#: addon\globalPlugins\freeAudio\getem.py:720
msgid ""
"Please enter your GETEM username and password in freeAudio's settings first."
msgstr ""
"Veuillez d'abord entrer votre nom d'utilisateur et votre mot de passe GETEM "
"dans les paramètres de freeAudio."

#. Translators: Error returned by search_getem() when the GETEM catalog page itself could not be fetched (network failure).
#: addon\globalPlugins\freeAudio\getem.py:763
msgid "Could not reach GETEM's catalog. Please check your internet connection."
msgstr ""
"Impossible d'accéder au catalogue de GETEM. Veuillez vérifier votre "
"connexion Internet."

#. Translators: Fallback chapter title for a multi-part work whose parts have no individual names; '{0}' is the book title, '{1}' the 1-based part number.
#: addon\globalPlugins\freeAudio\getem.py:886
msgid "{0} - Part {1}"
msgstr "{0} - Partie {1}"

#: addon\globalPlugins\freeAudio\getem.py:924
#: addon\globalPlugins\freeAudio\getem.py:1151
msgid ""
"No playable audio file was found on this work's GETEM page. It may require "
"manual download from the site."
msgstr ""
"Aucun fichier audio lisible n'a été trouvé sur la page GETEM de cette œuvre. "
"Cela peut nécessiter un téléchargement manuel depuis le site."

#. Translators: Error returned by get_book_by_url() when the pasted URL doesn't look like a GETEM work page link.
#: addon\globalPlugins\freeAudio\getem.py:1115
msgid "This doesn't look like a GETEM work link."
msgstr "Cela ne ressemble pas à un lien de travail GETEM."

#. Translators: Raised when a chapter download completes but produced a zero-byte file, usually because the GETEM session was not actually logged in.
#: addon\globalPlugins\freeAudio\getem.py:1249
msgid "The downloaded file was empty. Please check your GETEM login."
msgstr ""
"Le fichier téléchargé était vide. Veuillez vérifier votre identifiant GETEM."

#. Translators: Raised when the URL fetched for a chapter returns a response that is not audio at all (e.g. an HTML error/login page).
#: addon\globalPlugins\freeAudio\getem.py:1267
#, python-format
msgid "GETEM did not return audio for this part: %s"
msgstr "GETEM n'a pas renvoyé l'audio pour cette partie: %s"

#. Translators: Same failure as the message above (no valid audio came back for this part), used when there is no response snippet available to show.
#: addon\globalPlugins\freeAudio\getem.py:1269
msgid "GETEM did not return a playable audio file for this part."
msgstr "GETEM n'a pas renvoyé de fichier audio lisible pour cette partie."

#. Translators: Value spoken for an equalizer band slider. %+d is the gain in decibels with an explicit sign, e.g. "+5 dB" or "-3 dB".
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:18
#, python-format
msgid "%+d dB"
msgstr "%+d dB"

#. Translators: Label of the checkbox that turns the ten-band graphic equalizer on or off.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:30
msgid "Equalizer On/Off"
msgstr "Égaliseur activé/désactivé"

#. Translators: Label (and accessible name) of one equalizer band slider. %g is the band's centre frequency in hertz, e.g. "62 Hz" or "12000 Hz".
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:38
#, python-format
msgid "%g Hz"
msgstr "%g Hz"

#. Translators: Label of the equalizer button that sets every band back to 0 dB.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:52
msgid "Reset"
msgstr "Réinitialiser"

#. Translators: Label of the equalizer button that saves the equalizer settings to the configuration.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:54
msgid "Save"
msgstr "Enregistrer"

#. Explicit unit announcement also covers NVDA versions that use the
#. native slider value rather than the custom MSAA value.
#. Translators: Spoken after an equalizer slider is changed. %(frequency)g is the band's centre frequency in hertz and %(gain)+d is the new gain in decibels with an explicit sign, e.g. "1000 Hz, +4 dB". Keep both placeholders.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:84
#, python-format
msgid "%(frequency)g Hz, %(gain)+d dB"
msgstr "%(frequency)g Hz, %(gain)+d dB"

#. Translators: Spoken after the Reset button sets all equalizer bands back to 0 dB.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:92
msgid "Equalizer reset"
msgstr "Réinitialisation de l'égaliseur"

#. Translators: Spoken when saving the equalizer settings to the configuration fails.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:99
msgid "Could not save Equalizer settings"
msgstr "Impossible d'enregistrer les paramètres de l'Égaliseur"

#. Translators: Spoken after the equalizer settings were saved to the configuration.
#: addon\globalPlugins\freeAudio\graphicEqualizer.py:102
msgid "Equalizer settings saved"
msgstr "Paramètres de l'égaliseur enregistrés"

#. Shown as this book's narrator (see GutenbergAudiobook.__init__) instead
#. of leaving the field blank the way LibriVox does (which credits a
#. different human reader per chapter) - every book in this collection
#. shares the same kind of narration, so one fixed, honest label is more
#. useful here than an empty field.
#. Translators: Fixed narrator label shown for every book in this AI-narrated collection, in place of a per-book human reader's name.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:139
msgid "AI-generated narration (Microsoft neural text-to-speech)"
msgstr "Narration générée par IA (Microsoft neuronal text-to-speech)"

#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:217
#, python-format
msgid "AI narration, %s"
msgstr "Narration IA, %s"

#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:219
msgid "AI narration"
msgstr "Narration IA"

#. Translators: %s = the specific AI voice name, e.g. "SteffanNeural"
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:308
#, python-format
msgid "AI-generated narration (Microsoft neural text-to-speech, %s voice)"
msgstr "Narration générée par IA (Microsoft neuronal text-to-speech, voix %s)"

#. Translators: shown as this book's source in the station-details
#. dialog and the Audio Books tab - kept distinct from bare
#. "LibriVox"/"GETEM" (see RadioDialog._audiobook_source_label_for())
#. since this collection is machine-narrated rather than a
#. volunteer-read or library-hosted human-narrated catalog.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:362
msgid "Project Gutenberg (AI narration)"
msgstr "Project Gutenberg (narration IA)"

#. Translators: Error returned when the resolved archive.org item exists but isn't tagged as part of this specific audiobook collection.
#: addon\globalPlugins\freeAudio\gutenberg_audiobooks.py:459
msgid ""
"This archive.org item isn't part of the Project Gutenberg Open Audiobook "
"Collection."
msgstr ""
"Cet élément de archive.org ne fait pas partie de la collection de livres "
"audio ouverts du Project Gutenberg."

#. Translators: %(name)s = folder name, %(count)d = number of audio files found in it
#: addon\globalPlugins\freeAudio\jukebox.py:1039
#, python-format
msgid "%(name)s (folder, %(count)d tracks)"
msgstr "%(name)s (dossier, %(count)d morceaux)"

#. Translators: Error returned by JukeboxManager.add_file() when the given path does not exist; %s is the file path.
