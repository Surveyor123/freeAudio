msgstr "%s afspeelsneltoets"

#. ── 2. Create / refresh a script for every entry ─────────────────────
#. Translators: Script category shown in NVDA's Input Gestures dialog, grouping the auto-generated 'play this jukebox entry' shortcuts separately from freeAudio's main commands.
#: addon\globalPlugins\freeAudio\__init__.py:802
msgid "freeAudio Jukebox"
msgstr "freeAudio Jukebox"

#. Translators: Spoken if a per-jukebox-entry shortcut is triggered after that entry was removed from the jukebox since the shortcut was created; %s is the entry's display title.
#: addon\globalPlugins\freeAudio\__init__.py:823
#, python-format
msgid "Entry no longer in the jukebox: %s"
msgstr "Item niet langer in de jukebox: %s"

#. ── 2. Create / refresh a script for every book ──────────────────────
#. Translators: Script category shown in NVDA's Input Gestures dialog, grouping the auto-generated 'play this audio book' shortcuts separately from freeAudio's main commands.
#: addon\globalPlugins\freeAudio\__init__.py:942
msgid "freeAudio Audio Books"
msgstr "freeAudio Luisterboeken"

#. Translators: Spoken if a per-audio-book shortcut is triggered after that book was removed from the library since the shortcut was created; %s is the book's title.
#: addon\globalPlugins\freeAudio\__init__.py:990
#, python-format
msgid "Audio book no longer in the library: %s"
msgstr "Luisterboek niet langer in de bibliotheek: %s"

#. Translators: Spoken while an audio book's list of parts is being fetched before it starts playing; %s is the book's title.
#: addon\globalPlugins\freeAudio\__init__.py:998
#, python-format
msgid "Loading %s"
msgstr "Laden: %s"

#. Translators: Spoken when a per-audio-book shortcut can't start playback because the book's parts could not be prepared; %s is the book's title.
#: addon\globalPlugins\freeAudio\__init__.py:1029
#, python-format
msgid "Could not play %s"
msgstr "Kon %s niet afspelen"

#. Translators: Menu item that opens the freeAudio station browser dialog
#: addon\globalPlugins\freeAudio\__init__.py:1042
msgid "Station &Browser...\tCtrl+Win+R"
msgstr "Stations&verkenner...\tCtrl+Win+R"

#. Translators: Menu item that opens freeAudio settings in NVDA preferences
#: addon\globalPlugins\freeAudio\__init__.py:1051
msgid "freeAudio &Settings..."
msgstr "freeAudio &Instellingen..."

#. Translators: Menu item that manually triggers the update check
#: addon\globalPlugins\freeAudio\__init__.py:1060
msgid "Check for &Updates..."
msgstr "Controleer op &Updates..."

#. Translators: Label of the freeAudio submenu in NVDA Tools menu
#: addon\globalPlugins\freeAudio\__init__.py:1073
msgid "&freeAudio"
msgstr "&freeAudio"

#. Translators: Name of an NVDA command; opens the freeAudio station browser dialog on its main Stations tab.
#: addon\globalPlugins\freeAudio\__init__.py:1141
msgid "Open freeAudio station browser"
msgstr "Open de freeAudio stationsverkenner"

# | msgid "Open FreeRadio station browser"
#. Translators: Name of an NVDA command; opens the station browser dialog on the Audio Books tab.
#: addon\globalPlugins\freeAudio\__init__.py:1151
msgid "Open freeAudio audio book library"
msgstr "Open freeAudio luisterboekbibliotheek"

# | msgid "Podcast subscriptions"
#. Translators: Name of an NVDA command; opens the station browser dialog on the Podcasts tab.
#: addon\globalPlugins\freeAudio\__init__.py:1161
msgid "Open freeAudio podcast subscriptions"
msgstr "Open freeAudio podcastabonnementen"

#. Translators: Name of an NVDA command; opens the station browser dialog on the local Jukebox tab.
#: addon\globalPlugins\freeAudio\__init__.py:1171
msgid "Open freeAudio local jukebox"
msgstr "Open freeAudio lokale jukebox"

#. Translators: Name of an NVDA command whose behaviour depends on what is currently playing: adds a live station to favourites, or downloads the current audio book/podcast episode.
#: addon\globalPlugins\freeAudio\__init__.py:1181
msgid ""
"Add currently playing station to favourites, download the whole audio book "
"if one is playing, or download the episode if a podcast is playing"
msgstr ""
"Voeg het momenteel afgespeelde station toe aan favorieten, download het hele "
"luisterboek als er een wordt afgespeeld, of download de aflevering als er "
"een podcast wordt afgespeeld"

#. Translators: Spoken when this shortcut is pressed while something is playing that is neither a station, podcast episode, nor audio book (e.g. a local jukebox track).
#: addon\globalPlugins\freeAudio\__init__.py:1201
msgid "The shortcut is only for stations, podcasts or audio books"
msgstr "De sneltoets is alleen voor stations, podcasts of luisterboeken"

#. Translators: Spoken when the currently playing station is already saved in favourites; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:1223
#, python-format
msgid "Already in favourites: %s"
msgstr "Staat al in favorieten: %s"

#. Translators: Spoken after successfully adding the currently playing station to favourites; %s is the station name.
#: addon\globalPlugins\freeAudio\__init__.py:1227
#, python-format
msgid "Added to favourites: %s"
msgstr "Toegevoegd aan favorieten: %s"

#. Translators: Spoken when this shortcut is pressed to download an audio book but no audio book (GETEM/Gutenberg/LibriVox) is currently playing.
#: addon\globalPlugins\freeAudio\__init__.py:1242
msgid "No audio book is playing"
msgstr "Er wordt geen luisterboek afgespeeld"

#. Translators: Spoken when downloading the currently playing audio book fails.
#: addon\globalPlugins\freeAudio\__init__.py:1249
msgid "Could not download this audio book."
msgstr "Kan dit luisterboek niet downloaden."

#. Translators: Spoken once when a radio station (currently ABC Australia stations) is played through a special playback mode, because it would otherwise stutter.
#: addon\globalPlugins\freeAudio\__init__.py:1326
msgid "This station uses a special playback mode to prevent stuttering."
msgstr ""
"Dit station gebruikt een speciale afspeelmodus om haperingen te voorkomen."

