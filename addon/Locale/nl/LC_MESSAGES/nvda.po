#: addon\globalPlugins\freeAudio\bookmarkUI.py:439
msgid "Add &Voice Note..."
msgstr "&Spraaknotitie toevoegen..."

#. Translators: Bookmark context-menu item; removes the text and voice note of the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:441
msgid "&Clear Notes"
msgstr "Notities &wissen"

#. Translators: Bookmark context-menu item; plays the section between the bookmarks marked with '.' over and over.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:444
msgid "&Repeat Between Marked Bookmarks"
msgstr "&Herhalen tussen gemarkeerde bladwijzers"

#. Translators: Bookmark context-menu item; turns off the repeat mode.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:446
