#. Translators: Spoken when no audio output devices could be found on the system at all.
#. Translators: Spoken when no output devices are found while setting up audio mirroring.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:57
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:191
msgid "No audio output devices found"
msgstr "Geen audio-uitvoerapparaten gevonden"

#. Translators: Spoken instead of showing a picker, when only one physical audio output device exists.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:63
msgid ""
"Only one physical audio output device is available. freeAudio uses the "
"system default output."
msgstr ""
"Er is slechts één fysiek audio-uitvoerapparaat beschikbaar. freeAudio "
"gebruikt de standaarduitvoer van het systeem."

#. Translators: First entry in the output-device list; means 'use whatever Windows currently has as its default output'.
#. Translators: Same meaning as 'System default' above; label shown when announcing the currently active output device.
#. Translators: Same 'System default' first-entry convention as the main output-device picker (see audioDeviceMixin.py), used here to populate this dialog's own device list.
#. Translators: Same 'System default' first-entry convention as the other device pickers, used here to populate the Settings panel's device list.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:71
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:159
#: addon\globalPlugins\freeAudio\obligatoMixin.py:95
#: addon\globalPlugins\freeAudio\radioDialog.py:1712
#: addon\globalPlugins\freeAudio\settingsPanel.py:660
msgid "System default"
msgstr "Systeemstandaard"

#. Translators: Prompt of the dialog listing devices to choose as freeAudio's main playback output.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:96
msgid "Select the main output device:"
msgstr "Selecteer het hoofduitvoerapparaat:"

#. Translators: Title of the dialog for choosing freeAudio's main output device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:98
msgid "freeAudio Output Device"
msgstr "freeAudio-uitvoerapparaat"

#. Translators: Spoken when switching the main output device fails; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:123
#, python-format
msgid "Could not switch to output device: %s"
msgstr "Kon niet overschakelen naar uitvoerapparaat: %s"

#. Translators: Spoken after successfully switching the main output device; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:161
#, python-format
msgid "Output device: %s"
msgstr "Uitvoerapparaat: %s"

#. Translators: Name of an NVDA command in the Input Gestures dialog; starts/stops simultaneously playing audio through a second output device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:165
msgid "Mirror audio to an additional output device"
msgstr "Dupliceer audio naar een extra uitvoerapparaat"

#. Translators: Spoken when audio mirroring to a secondary device is turned off.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:174
msgid "Audio mirror stopped"
msgstr "Audio duplicatie gestopt"

#. Translators: Spoken if the user tries to start audio mirroring while nothing is playing.
#. Translators: Spoken when the add-bookmark command is used while nothing is playing.
#. Translators: Spoken when the delayed single-press action fires and finds nothing is playing.
#. Translators: Spoken when the double-press (song-capture) gesture is used while nothing is playing.
#. Translators: Spoken when this shortcut is pressed while nothing is playing.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:179
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:50
#: addon\globalPlugins\freeAudio\recordingMixin.py:136
#: addon\globalPlugins\freeAudio\recordingMixin.py:336
#: addon\globalPlugins\freeAudio\__init__.py:1189
msgid "No station is playing"
msgstr "Er wordt geen station afgespeeld"

#. Translators: Prompt of the dialog for choosing the secondary (mirror) output device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:206
msgid "Select additional output device for audio mirror:"
msgstr "Selecteer een extra uitvoerapparaat voor audio duplicatie:"

#. Translators: Title of the dialog for choosing the secondary mirror output device.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:208
msgid "Mirror Audio"
msgstr "Dupliceer audio"

#. Translators: Spoken once mirroring to the chosen secondary device starts successfully; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:237
#, python-format
msgid "Mirroring to: %s"
msgstr "Dupliceren naar: %s"

#. Translators: Spoken when starting the audio mirror to the chosen device fails; %s is the device name.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:240
#, python-format
msgid "Could not mirror to: %s"
msgstr "Kon niet dupliceren naar: %s"

#. Translators: Spoken automatically when the user's selected output device is unplugged; freeAudio has fallen back to the system default.
#: addon\globalPlugins\freeAudio\audioDeviceMixin.py:273
msgid "Audio device disconnected. Switched to system default."
msgstr ""
"Het audioapparaat is losgekoppeld. Er is overgeschakeld naar de "
"systeemstandaard."

#. Translators: Name of an NVDA command; raises freeAudio's playback volume by 5 (of 200 max, capped at 100 when saved).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:33
msgid "Increase freeAudio volume by 5"
msgstr "Verhoog het volume van freeAudio met 5"

#. Translators: Spoken after volume is changed with the volume-up/down commands; %d is the new volume level.
#. Translators: Spoken after volume is changed; %d is the new volume level.
#. Translators: Spoken when F5 (volume down) is pressed inside the dialog; %d is the new volume level. Same wording as the main volumeDown NVDA command.
#. Translators: Spoken when F6 (volume up) is pressed inside the dialog; %d is the new volume level. Same wording as the main volumeUp NVDA command.
#. Translators: Spoken when Ctrl+Up (volume up) is pressed inside the dialog on a focused control that doesn't otherwise handle it; %d is the new volume level. Same wording as the main volumeUp NVDA command.
#. Translators: Spoken when Ctrl+Down (volume down) is pressed inside the dialog; %d is the new volume level. Same wording as the main volumeDown NVDA command.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:42
#: addon\globalPlugins\freeAudio\audioFxMixin.py:56
#: addon\globalPlugins\freeAudio\radioDialog.py:4129
#: addon\globalPlugins\freeAudio\radioDialog.py:4143
#: addon\globalPlugins\freeAudio\radioDialog.py:4324
#: addon\globalPlugins\freeAudio\radioDialog.py:4332
#, python-format
msgid "Volume %d"
msgstr "Volume %d"

#. Translators: Name of an NVDA command; lowers freeAudio's playback volume by 5.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:47
msgid "Decrease freeAudio volume by 5"
msgstr "Verlaag het volume van freeAudio met 5"

#. Translators: Name of an NVDA command; speeds up playback rate, podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:61
msgid "Increase podcast, audio book and jukebox playback speed"
msgstr "Afspeelsnelheid van podcasts, luisterboeken en jukebox verhogen"

#. Translators: Name of an NVDA command; slows down playback rate, podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:70
msgid "Decrease podcast, audio book and jukebox playback speed"
msgstr "Afspeelsnelheid van podcasts, luisterboeken en jukebox verlagen"

#. Translators: Spoken when the playback-rate command returns the rate to normal (1.0x).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:81
msgid "Rate normal"
msgstr "Normale snelheid"

#. Translators: Spoken after changing playback rate; %.1f is the new rate, e.g. '1.5' meaning 1.5x speed.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:84
#, python-format
msgid "Rate %.1f"
msgstr "Snelheid %.1f"

#. Translators: Spoken when playback-rate change fails because the optional bass_fx library used for time-stretching isn't installed.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:88
msgid ""
"Playback speed control needs the bass_fx add-on library — see the freeAudio "
"docs."
msgstr ""
"Voor het beheren van de afspeelsnelheid is de add-onbibliotheek bass_fx "
"nodig - zie de freeAudio-documentatie."

#. Translators: Spoken when the user tries to change playback rate while playing a live radio station rather than a podcast/audiobook.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:91
msgid "Playback speed control is only available for podcasts."
msgstr "Afspeelsnelheidsregeling is alleen beschikbaar voor podcasts."

#. Translators: Generic fallback spoken when the playback-rate change fails for an unrecognised reason.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:94
msgid "Could not change playback speed."
msgstr "Kon de afspeelsnelheid niet wijzigen."

#. Translators: Name of an NVDA command; toggles a low-frequency EQ boost on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:132
msgid "Toggle bass boost"
msgstr "Basversterking in- of uitschakelen"

#. Translators: Short label used in the 'X enabled/disabled' announcement (see _toggle_eq_band) when toggling the bass-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:138
#: addon\globalPlugins\freeAudio\radioDialog.py:780
#: addon\globalPlugins\freeAudio\settingsPanel.py:181
msgid "EQ: Bass Boost"
msgstr "EQ: Basversterking"

#. Translators: Name of an NVDA command; toggles a high-frequency EQ boost on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:142
msgid "Toggle treble boost"
msgstr "Hoogfrequentieversterking in-/uitschakelen"

#. Translators: Short label used in the 'X enabled/disabled' announcement when toggling the treble-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:148
#: addon\globalPlugins\freeAudio\radioDialog.py:780
#: addon\globalPlugins\freeAudio\settingsPanel.py:182
msgid "EQ: Treble Boost"
msgstr "EQ: Hoogfrequentieversterking"

#. Translators: Name of an NVDA command; toggles a mid-range EQ boost tuned for vocal clarity on/off.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:152
msgid "Toggle vocal boost"
msgstr "Stemversterking in- of uitschakelen"

#. Translators: Short label used in the 'X enabled/disabled' announcement when toggling the vocal-boost EQ band.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:158
#: addon\globalPlugins\freeAudio\radioDialog.py:780
#: addon\globalPlugins\freeAudio\settingsPanel.py:183
msgid "EQ: Vocal Boost"
msgstr "EQ: Stemversterking"

#. Translators: Announcement after toggling an EQ band; %(effect)s is one of the 'EQ: ... Boost' labels above, %(state)s is 'enabled'/'disabled' below.
#. Translators: Announcement after toggling; %(effect)s is the plain-text feature name below (with its '&' access-key marker stripped), %(state)s is 'enabled'/'disabled'.
#. Translators: Same toggle-announcement pattern as script_toggleAnnounceTrackChanges above.
#. Translators: Effect on/off status spoken when hovering over an item in the Effects checklist; %(effect)s is the effect name, %(state)s the enabled/disabled word below.
#. Translators: Same effect on/off announcement as _on_fx_focus above, spoken here after actually toggling the effect (checklist click).
#. Translators: Same effect on/off announcement, spoken here after toggling via the Ctrl+1..Ctrl+0 keyboard shortcuts.
#. Translators: Same "%(effect)s %(state)s" announcement pattern as radioDialog.py's _toggle_eq_band; spoken here when hovering an item in the Settings effects checklist. %(state)s is "enabled"/"disabled" below.
#. Translators: Same announcement as the hover handler above, spoken here after actually toggling an effect via the checklist checkbox.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:221
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:76
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:125
#: addon\globalPlugins\freeAudio\radioDialog.py:1797
#: addon\globalPlugins\freeAudio\radioDialog.py:1810
#: addon\globalPlugins\freeAudio\radioDialog.py:1835
#: addon\globalPlugins\freeAudio\settingsPanel.py:707
#: addon\globalPlugins\freeAudio\settingsPanel.py:719
#, python-format
msgid "%(effect)s %(state)s"
msgstr "%(effect)s %(state)s"

#. Translators: Second half of the 'X enabled/disabled' announcement in _toggle_eq_band; describes the EQ band's new on/off state.
#. Translators: Second half of the toggle announcement above; describes the feature's new on/off state.
#. Translators: Second half of the toggle announcement; describes the feature's new on/off state.
#. Translators: The two possible %(state)s values above, and in the two other identical announcements in _on_fx_changed/_toggle_fx_by_index below.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:224
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:80
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:129
#: addon\globalPlugins\freeAudio\radioDialog.py:1800
#: addon\globalPlugins\freeAudio\radioDialog.py:1812
#: addon\globalPlugins\freeAudio\radioDialog.py:1837
#: addon\globalPlugins\freeAudio\settingsPanel.py:709
#: addon\globalPlugins\freeAudio\settingsPanel.py:721
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:449
msgid "enabled"
msgstr "ingeschakeld"

#: addon\globalPlugins\freeAudio\audioFxMixin.py:224
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:80
#: addon\globalPlugins\freeAudio\miscTogglesMixin.py:129
#: addon\globalPlugins\freeAudio\radioDialog.py:1800
#: addon\globalPlugins\freeAudio\radioDialog.py:1812
#: addon\globalPlugins\freeAudio\radioDialog.py:1837
#: addon\globalPlugins\freeAudio\settingsPanel.py:709
#: addon\globalPlugins\freeAudio\settingsPanel.py:721
#: addon\globalPlugins\freeAudio\timeshiftMixin.py:449
msgid "disabled"
msgstr "uitgeschakeld"

#. Translators: Name of an NVDA command; cycles the sound effect played when switching stations (crossfade/instant cut/tuning effect).
#: addon\globalPlugins\freeAudio\audioFxMixin.py:229
msgid "Toggle station switch transition (crossfade)"
msgstr "Schakel vloeiende overgang van station (crossfade) in of uit"

#. Translators: One of the station-transition modes cycled by the crossfade command: plays no transition sound, cuts instantly.
#. Translators: Choices for the crossfade setting, same wording and order as the in-app toggleStationTransition command's cycle (audioFxMixin.py) - continues for the next three lines.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:237
#: addon\globalPlugins\freeAudio\settingsPanel.py:226
msgid "Instant cut (no crossfade)"
msgstr "Directe overgang (zonder crossfade)"

#. Translators: One of the station-transition modes: a brief 1-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:239
#: addon\globalPlugins\freeAudio\settingsPanel.py:227
msgid "Short crossfade (1 second)"
msgstr "Korte crossfade (1 seconde)"

#. Translators: One of the station-transition modes: a longer 2-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:241
#: addon\globalPlugins\freeAudio\settingsPanel.py:228
msgid "Normal crossfade (2 seconds)"
msgstr "Normale crossfade (2 seconden)"

#. Translators: One of the station-transition modes: plays a radio-tuning sound effect instead of a crossfade.
#: addon\globalPlugins\freeAudio\audioFxMixin.py:243
#: addon\globalPlugins\freeAudio\settingsPanel.py:229
msgid "Station tuning sound effect"
msgstr "Stationsafstemgeluidseffect"

#. Translators: Name of an NVDA command; adds a bookmark at the current playback position of an audio book part, podcast episode or jukebox track.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:39
msgid "Add a bookmark at the current position (audio books, podcasts, jukebox)"
msgstr ""
"Bladwijzer toevoegen op de huidige positie (luisterboeken, podcasts, "
"jukebox)"

#. Translators: Spoken when the add-bookmark command is used on a live radio station.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:55
msgid ""
"Bookmarks are available for audio books, podcasts and jukebox tracks only"
msgstr ""
"Bladwijzers zijn alleen beschikbaar voor luisterboeken, podcasts en "
"jukeboxnummers"

#. Translators: Spoken when the current playback position can't be read, so no bookmark is added.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:62
msgid "Could not read the playback position"
msgstr "Kon de afspeelpositie niet lezen"

#. Translators: Spoken after adding a bookmark; %(name)s is its default name (ordinal), %(time)s the position.
#: addon\globalPlugins\freeAudio\bookmarkMixin.py:67
#, python-format
msgid "Bookmark added: %(name)s, %(time)s"
msgstr "Bladwijzer toegevoegd: %(name)s, %(time)s"

#. Translators: Default name of a bookmark; %d is its ordinal among the item's bookmarks, sorted by position.
#: addon\globalPlugins\freeAudio\bookmarks.py:142
#, python-format
msgid "Bookmark %d"
msgstr "Bladwijzer %d"

#. Translators: Fallback default bookmark name if its ordinal can't be determined.
#: addon\globalPlugins\freeAudio\bookmarks.py:144
msgid "Bookmark"
msgstr "Bladwijzer"

#. Translators: Title of the dialog used to record a voice note for a bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:73
msgid "Voice Note"
msgstr "Spraaknotitie"

#. Translators: Text of the voice-note recording dialog.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:79
msgid "Recording from the microphone. Press Stop and Save when you are done."
msgstr ""
"Er wordt opgenomen vanaf de microfoon. Druk op Stoppen en opslaan als je "
"klaar bent."

#. Translators: Button label; stops the voice-note recording and saves it to the bookmark.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:84
msgid "&Stop and Save"
msgstr "&Stoppen en opslaan"

#. Translators: Spoken when the microphone can't be opened for a voice note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:101
msgid "Could not start recording. Check that a microphone is available."
msgstr ""
"Kon de opname niet starten. Controleer of er een microfoon beschikbaar is."

#. Translators: Spoken when voice-note recording has started.
#. Translators: Tab label for the recording controls and active/past recordings list.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:105
#: addon\globalPlugins\freeAudio\radioDialog.py:712
msgid "Recording"
msgstr "Opnemen"

#. Translators: Spoken when the recorded voice note could not be saved.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:112
msgid "Could not save the voice note"
msgstr "Kon de spraaknotitie niet opslaan"

#. Translators: Label above the list of bookmarks of the selected podcast episode / audio book / jukebox track.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:137
msgid "Bookmarks:"
msgstr "Bladwijzers:"

#. Translators: Accessible name of the bookmarks list.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:140
msgid "Bookmarks of the selected item"
msgstr "Bladwijzers van het geselecteerde item"

#. Translators: Marker appended to a bookmark's list row when it has a text note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:158
msgid "[text]"
msgstr "[tekst]"

#. Translators: Marker appended to a bookmark's list row when it has a voice note.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:161
msgid "[voice note]"
msgstr "[spraaknotitie]"

#. Translators: Spoken after unmarking a bookmark; %s is its name.
#. Translators: Spoken after unmarking a favourite station in the multi-select removal flow; %s is the station name.
#. Translators: Spoken after unmarking a liked song in the multi-select removal flow; %s is the song string.
#. Translators: Spoken after unmarking an audio book in the multi-select removal flow; %s is the book title.
#. Translators: Spoken after unmarking a jukebox entry in the multi-select removal flow; %s is the entry title.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:249
#: addon\globalPlugins\freeAudio\radioDialog.py:5022
#: addon\globalPlugins\freeAudio\radioDialog.py:5835
#: addon\globalPlugins\freeAudio\radioDialog.py:7890
#: addon\globalPlugins\freeAudio\radioDialog.py:9079
#, python-format
msgid "Unmarked: %s"
msgstr "Niet gemarkeerd: %s"

#. Translators: Spoken after marking a bookmark; %s is its name.
#. Translators: Spoken after marking a favourite station in the multi-select removal flow; %s is the station name.
#. Translators: Spoken after marking a liked song in the multi-select removal flow; %s is the song string.
#. Translators: Spoken after marking an audio book in the multi-select removal flow; %s is the book title.
#. Translators: Spoken after marking a jukebox entry in the multi-select removal flow; %s is the entry title.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:253
#: addon\globalPlugins\freeAudio\radioDialog.py:5026
#: addon\globalPlugins\freeAudio\radioDialog.py:5839
#: addon\globalPlugins\freeAudio\radioDialog.py:7894
#: addon\globalPlugins\freeAudio\radioDialog.py:9083
#, python-format
msgid "Marked: %s"
msgstr "Gemarkeerd: %s"

#. Translators: Prompt of the bookmark rename dialog; leaving it empty restores the default name.
#: addon\globalPlugins\freeAudio\bookmarkUI.py:294
